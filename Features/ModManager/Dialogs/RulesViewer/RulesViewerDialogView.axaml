<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
             xmlns:vm="clr-namespace:RimSharp.Features.ModManager.Dialogs.RulesViewer"
             xmlns:sys="using:System"
             x:Class="RimSharp.Features.ModManager.Dialogs.RulesViewer.RulesViewerDialogView"
             x:DataType="vm:RulesViewerDialogViewModel"
             x:CompileBindings="True"
             Width="700"
             Height="560"
             Title="{Binding Title}">

    <dialogs:BaseDialog.MainContent>
        <Grid RowDefinitions="Auto,*" Margin="10,10,10,0">

            <!-- Mod header -->
            <Border Grid.Row="0" Classes="panel-subtle" Padding="12" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Mod.DisplayName}" FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource BrushTextStrong}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Mod.PackageId}" FontSize="11" FontStyle="Italic"
                               VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}"
                               TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Rules list / empty state -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  IsVisible="{Binding HasRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuleRowViewModel">
                                <Border BorderBrush="{DynamicResource BrushBorderDefault}" BorderThickness="1"
                                        CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <!-- Kind badge -->
                                        <Border Grid.Column="0" Background="{DynamicResource BrushBgAction}"
                                                CornerRadius="3" Padding="6,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushTextOnDark}"/>
                                        </Border>

                                        <!-- Target / detail -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Target}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextStrong}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           Text="{Binding Name}" FontSize="11" FontStyle="Italic"
                                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                                <TextBlock IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           Text="{Binding Comment}" FontSize="11" FontStyle="Italic"
                                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                                <TextBlock Text="hard" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource BrushTextError}"
                                                           IsVisible="{Binding Hard}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Origin badges -->
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Origins}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Right">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Border Background="{DynamicResource BrushBgSuccess}"
                                                            CornerRadius="3" Padding="5,3">
                                                        <TextBlock Text="{Binding}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushTextOnDark}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No rules applied to this mod." FontSize="13" FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock.IsVisible>
                            <Binding Path="HasRules" Converter="{StaticResource InvertedBooleanConverter}"/>
                        </TextBlock.IsVisible>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Close" Command="{Binding CloseCommand}" Classes="btn" MinWidth="90"/>
        </StackPanel>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>

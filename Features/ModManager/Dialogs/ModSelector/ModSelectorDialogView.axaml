<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
                    xmlns:vm="clr-namespace:RimSharp.Features.ModManager.Dialogs.ModSelector"
                    xmlns:sys="using:System"
                    x:Class="RimSharp.Features.ModManager.Dialogs.ModSelector.ModSelectorDialogView"
                    x:DataType="vm:ModSelectorDialogViewModel"
                    x:CompileBindings="True"
                    Classes="dialog-flush"
                    Width="780"
                    SizeToContent="Height"
                    CanResize="False"
                    Title="{Binding Title}">

    <dialogs:BaseDialog.MainContent>
        <StackPanel Margin="16,14" Spacing="11">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                     Classes="input" Height="30"
                     PlaceholderText="Search by Name or Package ID..."/>

            <ListBox ItemsSource="{Binding FilteredRows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     Classes="list-picker"
                     Height="330"
                     DoubleTapped="DataGrid_DoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModSelectorRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12.5"
                                               Foreground="{DynamicResource BrushTextBrown950}"
                                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <Border Classes="pill-badge"
                                            Classes.muted="{Binding IsDependencyHint}"
                                            Classes.custom="{Binding IsCustomHint}"
                                            Classes.overridden="{Binding IsOverriddenHint}"
                                            Classes.db="{Binding IsInheritedHint}"
                                            IsVisible="{Binding HasHint}">
                                        <TextBlock Text="{Binding HintText}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextStrong}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding PackageId}" Classes="mono-sub"/>
                            </StackPanel>

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Versions}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <Border Classes="pill-badge muted">
                                            <TextBlock Text="{Binding}" FontFamily="{DynamicResource RimSharpMonoFontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Classes="alert-box info" Padding="9,7">
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextInfo}"
                           Text="Mods with existing Custom rules can be updated; mods with Inherited rules will be overridden if customized; Mod Dependencies cannot be inverted."/>
            </Border>
        </StackPanel>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <Border Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Double-click a mod row to select immediately."
                           FontSize="11" Foreground="{DynamicResource BrushTextStrong}" Opacity="0.85"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="btn" MinWidth="92" Height="31"/>
                    <Button Content="Select" Command="{Binding ConfirmCommand}" Classes="btn-success" MinWidth="96" Height="31"/>
                </StackPanel>
            </Grid>
        </Border>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>

<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:RimSharp.Features.ModManager.Dialogs.DuplicateMods"
                    xmlns:infra="clr-namespace:RimSharp.Infrastructure.Mods.Validation.Duplicates"
                    xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
                    xmlns:i="https://github.com/projektanker/icons.avalonia"
                    xmlns:sys="using:System"
                    x:Class="RimSharp.Features.ModManager.Dialogs.DuplicateMods.DuplicateModDialogView"
                    x:DataType="local:DuplicateModDialogViewModel"
                    x:CompileBindings="True"
                    mc:Ignorable="d"
                    Classes="dialog-flush"
                    Width="820"
                    MaxHeight="640"
                    SizeToContent="Height"
                    CanResize="False"
                    Title="Resolve Duplicate Mods">

    <dialogs:BaseDialog.MainContent>
        <Grid RowDefinitions="Auto,*">
            <!-- Header Banner -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushBgPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Duplicate Mods Detected" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextBrown950}"/>
                        <TextBlock Text="Select which copy to keep for each Package ID, or choose Ignore. Unselected copies are permanently deleted from disk."
                                   Classes="field-hint"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="pill-badge hard" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <i:Icon Value="fa-trash-can" FontSize="10" Foreground="{DynamicResource BrushTextError}"/>
                            <TextBlock Text="Deletes unselected" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextError}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Scrollable Duplicate Groups -->
            <ScrollViewer Grid.Row="1"
                          Background="{DynamicResource BrushBgSurface}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="470">
                <ItemsControl ItemsSource="{Binding DuplicateGroups}" Margin="16,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DuplicateModGroupViewModel">
                            <Border Classes="group-card" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Group Header -->
                                    <Border Classes="group-head">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PackageId}"
                                                           FontFamily="{DynamicResource RimSharpMonoFontFamily}"
                                                           FontSize="12.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource BrushTextBrown950}"
                                                           VerticalAlignment="Center"/>
                                                <Border Classes="pill-badge muted">
                                                    <TextBlock Text="{Binding CopiesBadgeText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                </Border>
                                            </StackPanel>

                                            <ToggleButton Grid.Column="1" Classes="ignore-pill"
                                                          IsChecked="{Binding IsIgnored, Mode=TwoWay}">
                                                <TextBlock Text="{Binding IgnoreButtonText}"/>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>

                                    <!-- Mod Option Cards -->
                                    <ItemsControl ItemsSource="{Binding Mods}" Margin="10,9">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="infra:ModItemWrapper">
                                                <RadioButton GroupName="{Binding ParentGroup.GroupName}"
                                                             IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                             Classes="opt-card"
                                                             Classes.will-delete="{Binding WillBeDeleted}"
                                                             Margin="0,0,0,7">
                                                    <StackPanel Spacing="4">
                                                        <!-- Top line: Name + Badges + Outcome Pill -->
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                                           Foreground="{DynamicResource BrushTextBrown950}"
                                                                           VerticalAlignment="Center" Margin="0,0,7,2"/>
                                                                <Border Classes="pill-badge success" IsVisible="{Binding WasOriginallyActive}" Margin="0,0,5,2">
                                                                    <TextBlock Text="Active" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource BrushTextSuccess}"/>
                                                                </Border>
                                                                <Border Classes="pill-badge db" IsVisible="{Binding IsOriginal}" Margin="0,0,5,2">
                                                                    <TextBlock Text="Original" FontSize="10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource BrushTextBadgeMod}"/>
                                                                </Border>
                                                                <Border Classes="pill-badge muted" Margin="0,0,5,2">
                                                                    <TextBlock Text="{Binding Original.ModType, Converter={StaticResource ModTypeToDescriptionConverter}, FallbackValue='Unknown'}"
                                                                               FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                                </Border>
                                                            </WrapPanel>

                                                            <Border Grid.Column="1" Classes="pill-badge" VerticalAlignment="Top"
                                                                    Classes.success="{Binding IsKept}"
                                                                    Classes.hard="{Binding WillBeDeleted}"
                                                                    Classes.muted="{Binding IsKeptBecauseIgnored}">
                                                                <TextBlock Text="{Binding OutcomeText}" FontSize="10" FontWeight="Bold"
                                                                           Foreground="{DynamicResource BrushTextBrown950}"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Author & Steam ID -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Authors, FallbackValue='Unknown', TargetNullValue='Unknown', StringFormat='by {0}'}"
                                                                       FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            <TextBlock Text="{Binding SteamId, StringFormat='· Steam {0}'}"
                                                                       Classes="mono-sub"
                                                                       IsVisible="{Binding HasSteamId}"/>
                                                        </StackPanel>

                                                        <!-- Versions Strip -->
                                                        <ItemsControl ItemsSource="{Binding VersionStrings}" IsVisible="{Binding HasVersions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="sys:String">
                                                                    <Border Classes="ver-chip">
                                                                        <TextBlock Text="{Binding}" FontFamily="{DynamicResource RimSharpMonoFontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource BrushTextBrown950}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Full Folder Path -->
                                                        <TextBlock Text="{Binding Path, FallbackValue='N/A', TargetNullValue='N/A'}"
                                                                   Classes="mono-sub" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <Border Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding FooterSummaryText}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextStrong}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="btn" MinWidth="96" Height="31"/>
                    <Button Content="Apply Changes" Command="{Binding ApplyResolutionsCommand}"
                            Classes="btn-danger" IsVisible="{Binding HasDeletions}" MinWidth="125" Height="31"/>
                    <Button Content="Apply Changes" Command="{Binding ApplyResolutionsCommand}"
                            Classes="btn-success" IsVisible="{Binding !HasDeletions}" MinWidth="125" Height="31"/>
                </StackPanel>
            </Grid>
        </Border>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>
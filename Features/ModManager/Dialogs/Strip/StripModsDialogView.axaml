<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
                    xmlns:vm="clr-namespace:RimSharp.Features.ModManager.Dialogs.Strip"
                    xmlns:helpers="clr-namespace:RimSharp.Core.Helpers"
                    xmlns:i="https://github.com/projektanker/icons.avalonia"
                    x:Class="RimSharp.Features.ModManager.Dialogs.Strip.StripModsDialogView"
                    x:DataType="vm:StripDialogViewModel"
                    x:CompileBindings="True"
                    mc:Ignorable="d"
                    Classes="dialog-flush"
                    Title="{Binding Title}"
                    Width="900"
                    Height="640"
                    CanResize="False"
                    WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </dialogs:BaseDialog.Resources>

    <dialogs:BaseDialog.MainContent>
        <Grid RowDefinitions="Auto,*">
            <!-- Top Info & Tree Controls Banner -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushBgPanel}"
                    BorderBrush="{DynamicResource BrushBorderDefault}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel Spacing="9">
                    <Border Classes="alert-box info" Padding="10,7">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <i:Icon Grid.Column="0" Value="fa-circle-info" FontSize="12" Margin="0,2,0,0"
                                    Foreground="{DynamicResource BrushTextInfo}"/>
                            <TextBlock Grid.Column="1" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextInfo}"
                                       Text="Unused game-version folders and developer files (.git, Source, .vs, bin, obj) will be permanently removed from selected mods."/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                     Classes="input" Height="28" Width="210"
                                     PlaceholderText="Filter mods..."/>
                            <Border Classes="tri-seg">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Largest First" GroupName="StripSort" Classes="tri-btn tri-neutral"
                                                 IsChecked="{Binding IsSortLargestFirst, Mode=OneWay}"
                                                 Command="{Binding SetSortModeCommand}" CommandParameter="LargestFirst"/>
                                    <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                    <RadioButton Content="Name A–Z" GroupName="StripSort" Classes="tri-btn tri-neutral"
                                                 IsChecked="{Binding IsSortNameAZ, Mode=OneWay}"
                                                 Command="{Binding SetSortModeCommand}" CommandParameter="NameAZ"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Button Content="Select All" Command="{Binding SelectAllCommand}" Classes="btn-secondary btn-sm"/>
                            <Button Content="Select None" Command="{Binding SelectNoneCommand}" Classes="btn-secondary btn-sm"/>
                            <Button Content="Expand All" Command="{Binding ExpandAllCommand}" Classes="btn-secondary btn-sm"/>
                            <Button Content="Collapse All" Command="{Binding CollapseAllCommand}" Classes="btn-secondary btn-sm"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Virtualized Outliner ListBox -->
            <Panel Grid.Row="1" Background="{DynamicResource BrushBgSurface}">
                <ListBox ItemsSource="{Binding VisibleRows}"
                         Classes="outliner-list"
                         IsVisible="{Binding !HasNoFilteredMods}">
                    <ListBox.DataTemplates>
                        <!-- Parent Mod Row -->
                        <DataTemplate DataType="vm:StrippableModViewModel">
                            <Border Classes="outliner-parent" Classes.expanded="{Binding IsExpandedWithChildren}">
                                <Border.ContextMenu>
                                    <ContextMenu x:CompileBindings="False">
                                        <MenuItem Header="Open in Explorer"
                                                  Command="{Binding Data.OpenInExplorerCommand, Source={StaticResource Proxy}}"
                                                  CommandParameter="{Binding Mod.Path}">
                                            <MenuItem.Icon><i:Icon Value="fa-folder-open" FontSize="14"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsThreeState="True"
                                              VerticalAlignment="Center"/>

                                    <Button Grid.Column="1" Classes="outliner-expand-btn"
                                            Command="{Binding ToggleExpandCommand}">
                                        <Grid ColumnDefinitions="18,*,120,135" ColumnSpacing="9">
                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                <i:Icon Value="fa-chevron-down" FontSize="10"
                                                        Foreground="{DynamicResource BrushTextStrong}"
                                                        IsVisible="{Binding IsExpanded}"/>
                                                <i:Icon Value="fa-chevron-right" FontSize="10"
                                                        Foreground="{DynamicResource BrushTextStrong}"
                                                        IsVisible="{Binding !IsExpanded}"/>
                                            </Panel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Mod.DisplayName}"
                                                           FontWeight="Bold" FontSize="13"
                                                           MaxWidth="360"
                                                           Foreground="{DynamicResource BrushTextBrown950}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Mod.Path}"
                                                           VerticalAlignment="Center"/>
                                                <Border Classes="pill-badge muted">
                                                    <TextBlock Text="{Binding ItemsCountBadge}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                </Border>
                                            </StackPanel>

                                            <ProgressBar Grid.Column="2" Classes="size-bar"
                                                         Classes.empty="{Binding !HasSelectedSpace}"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding SizeSharePercent}"
                                                         VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedSize, Converter={StaticResource FileSizeConverter}}"
                                                           FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource BrushTextSuccess}"
                                                           IsVisible="{Binding HasSelectedSpace}"/>
                                                <TextBlock Text="{Binding SelectedSize, Converter={StaticResource FileSizeConverter}}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           IsVisible="{Binding !HasSelectedSpace}"/>
                                                <TextBlock Text="/" FontSize="12" Opacity="0.7"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding TotalStrippableSize, Converter={StaticResource FileSizeConverter}}"
                                                           FontSize="12" Opacity="0.75"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>

                        <!-- Child Strippable Item Row -->
                        <DataTemplate DataType="vm:StrippableItemViewModel">
                            <Border Classes="outliner-child-row" Classes.last="{Binding IsLastChild}">
                                <Border Classes="outliner-child" Classes.unchecked="{Binding !IsSelected}">
                                    <Border.ContextMenu>
                                        <ContextMenu x:CompileBindings="False">
                                            <MenuItem Header="Open in Explorer"
                                                      Command="{Binding Data.OpenInExplorerCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding FullPath}">
                                                <MenuItem.Icon><i:Icon Value="fa-folder-open" FontSize="14"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0" Classes="branch-elbow"/>

                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>

                                        <Border Grid.Column="2" Classes="pill-badge"
                                                Classes.db="{Binding IsFolder}"
                                                Classes.muted="{Binding IsFile}"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <i:Icon Value="fa-folder" FontSize="9.5" IsVisible="{Binding IsFolder}"
                                                        Foreground="{DynamicResource BrushTextBadgeMod}"/>
                                                <i:Icon Value="fa-file" FontSize="9.5" IsVisible="{Binding IsFile}"
                                                        Foreground="{DynamicResource BrushTextStrong}"/>
                                                <TextBlock Text="{Binding ItemTypeLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextStrong}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource BrushTextBrown950}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RelativePath}" Classes="mono-sub"
                                                       IsVisible="{Binding HasDistinctRelativePath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding FullPath}"/>
                                        </StackPanel>

                                        <Button Grid.Column="4"
                                                x:CompileBindings="False"
                                                Command="{Binding Data.OpenInExplorerCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding FullPath}"
                                                Classes="btn-secondary btn-sm btn-icon"
                                                ToolTip.Tip="Reveal in Explorer">
                                            <i:Icon Value="fa-folder-open" FontSize="11"/>
                                        </Button>

                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   MinWidth="70" TextAlignment="Right"
                                                   Foreground="{DynamicResource BrushTextBrown950}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>

                <Border Classes="surface-box" IsVisible="{Binding HasNoFilteredMods}"
                        Margin="16,12" Padding="16,24" VerticalAlignment="Top">
                    <TextBlock Text="No mods match your filter."
                               HorizontalAlignment="Center" FontStyle="Italic"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                </Border>
            </Panel>
        </Grid>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <Border Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Total space to recover:" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextBrown950}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalSelectedSize, Converter={StaticResource FileSizeConverter}}"
                               FontSize="13.5" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextSuccess}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FooterSelectionNote}" FontSize="11.5"
                               Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="btn" MinWidth="92" Height="31"/>
                    <Button Command="{Binding StripCommand}" Classes="btn-danger" MinWidth="135" Height="31">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="fa-scissors" FontSize="11"/>
                            <TextBlock Text="Strip Selected" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>
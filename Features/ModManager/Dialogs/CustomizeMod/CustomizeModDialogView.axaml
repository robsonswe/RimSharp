<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
                    xmlns:vm="clr-namespace:RimSharp.Features.ModManager.Dialogs.CustomizeMod"
                    xmlns:i="https://github.com/projektanker/icons.avalonia"
                    xmlns:sys="using:System"
                    x:Class="RimSharp.Features.ModManager.Dialogs.CustomizeMod.CustomizeModDialogView"
                    x:DataType="vm:CustomizeModDialogViewModel"
                    x:CompileBindings="True"
                    Classes="dialog-flush"
                    Width="840"
                    SizeToContent="Height"
                    CanResize="False"
                    Title="{Binding Title}">

    <dialogs:BaseDialog.MainContent>
        <TabControl Classes="tabs-rail" Height="506">

            <!-- TAB 1: OVERVIEW & POSITION -->
            <TabItem Header="Overview &amp; Position" Classes="rail-group" Tag="THIS MOD">
                <StackPanel Spacing="12">
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Overview &amp; Load Position" Classes="pane-title" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" Classes="fav-toggle" IsChecked="{Binding IsFavorite, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <i:Icon Value="fa-star" FontSize="12"/>
                                    <TextBlock Text="Favorite Mod" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <!-- Mutually Exclusive Load Order Position -->
                    <Border Classes="surface-box">
                        <StackPanel Spacing="9">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="Load Order Position" Classes="field-label" VerticalAlignment="Center"/>
                                    <Border Classes="pill-badge db">
                                        <TextBlock Text="{Binding InheritedLoadPositionLabel}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextBadgeMod}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Custom selection overrides inherited pinning." Classes="field-hint"/>
                            </StackPanel>

                            <Border Classes="tri-seg" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Use Inherited" GroupName="LoadPos" Classes="tri-btn tri-neutral"
                                                 IsChecked="{Binding IsPosUseInherited, Mode=OneWay}"
                                                 Command="{Binding SetLoadPositionCommand}" CommandParameter="UseInherited"/>
                                    <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                    <RadioButton Content="Normal" GroupName="LoadPos" Classes="tri-btn tri-neutral"
                                                 IsChecked="{Binding IsPosNormal, Mode=OneWay}"
                                                 Command="{Binding SetLoadPositionCommand}" CommandParameter="Normal"/>
                                    <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                    <RadioButton Content="Force Top" GroupName="LoadPos" Classes="tri-btn tri-neutral"
                                                 IsChecked="{Binding IsPosForceTop, Mode=OneWay}"
                                                 Command="{Binding SetLoadPositionCommand}" CommandParameter="ForceTop"/>
                                    <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                    <RadioButton Content="Force Bottom" GroupName="LoadPos" Classes="tri-btn tri-neutral"
                                                 IsChecked="{Binding IsPosForceBottom, Mode=OneWay}"
                                                 Command="{Binding SetLoadPositionCommand}" CommandParameter="ForceBottom"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="alert-box info" IsVisible="{Binding HasLoadPositionOverrideNotice}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <i:Icon Grid.Column="0" Value="fa-code-branch" FontSize="12" Margin="0,2,0,0"
                                            Foreground="{DynamicResource BrushTextInfo}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LoadPositionOverrideNotice}" FontSize="11.5"
                                               TextWrapping="Wrap" Foreground="{DynamicResource BrushTextInfo}"/>
                                </Grid>
                            </Border>

                            <Border Classes="alert-box danger" IsVisible="{Binding HasLoadPositionContradiction}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <i:Icon Grid.Column="0" Value="fa-triangle-exclamation" FontSize="12" Margin="0,2,0,0"
                                            Foreground="{DynamicResource BrushTextError}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LoadPositionContradictionWarning}" FontSize="11.5"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextError}"/>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Custom Pinning Reason / Comment:" Classes="field-hint"/>
                                <TextBox Text="{Binding LoadPositionComment, Mode=TwoWay}"
                                         Classes="input" Height="30"
                                         IsEnabled="{Binding CanEditLoadPositionReason}"
                                         PlaceholderText="Optional reason for overriding load position..."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Metadata -->
                    <Border Classes="surface-box">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="External URL" Classes="field-label"/>
                                <TextBox Text="{Binding ExternalUrl, Mode=TwoWay}" Classes="input" Height="30"
                                         PlaceholderText="https://steamcommunity.com/..."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="Local Tags" Classes="field-label"/>
                                <TextBox Text="{Binding Tags, Mode=TwoWay}" Classes="input" Height="30"
                                         PlaceholderText="Comma-separated tags"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Supported Versions -->
                    <Border Classes="surface-box">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Supported Versions" Classes="field-label" VerticalAlignment="Center"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding OriginalSupportedVersions}" IsVisible="{Binding HasOriginalVersions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Border Classes="pill-badge muted" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource RimSharpMonoFontFamily}"
                                                           FontSize="10.5" Foreground="{DynamicResource BrushTextStrong}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Custom Version Overrides (comma-separated):" Classes="field-hint"/>
                                <TextBox Text="{Binding SupportedVersions, Mode=TwoWay}" Classes="input" Height="30"
                                         PlaceholderText="e.g. 1.7, 1.8"/>
                            </StackPanel>

                            <Border Classes="alert-box warning" Padding="9,7">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <i:Icon Grid.Column="0" Value="fa-circle-info" FontSize="12" Margin="0,2,0,0"
                                            Foreground="{DynamicResource BrushTextBrown950}"/>
                                    <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextBrown950}"
                                               Text="App-only customization. Install Mlie's 'No Version Warning' mod to suppress version warnings in-game."/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: UNIFIED MOD RELATIONS -->
            <TabItem Classes="rail-group" Tag="RELATIONSHIPS">
                <TabItem.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Mod Relations" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActiveRelationsCount}"
                                   FontSize="10.5" Opacity="0.78" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </TabItem.Header>

                <StackPanel Spacing="12">
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Mod Relations" Classes="pane-title" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding AddRelationCommand}" Classes="btn btn-sm">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <i:Icon Value="fa-plus" FontSize="11"/>
                                    <TextBlock Text="Add Relation" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Filter Strip -->
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton Content="All" GroupName="RelFilter" Classes="f-pill" Margin="0,0,5,5"
                                     IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                     Command="{Binding SetRelationFilterCommand}" CommandParameter="All"/>
                        <RadioButton Content="Load Before" GroupName="RelFilter" Classes="f-pill" Margin="0,0,5,5"
                                     IsChecked="{Binding IsFilterBefore, Mode=OneWay}"
                                     Command="{Binding SetRelationFilterCommand}" CommandParameter="LoadBefore"/>
                        <RadioButton Content="Load After" GroupName="RelFilter" Classes="f-pill" Margin="0,0,5,5"
                                     IsChecked="{Binding IsFilterAfter, Mode=OneWay}"
                                     Command="{Binding SetRelationFilterCommand}" CommandParameter="LoadAfter"/>
                        <RadioButton Content="Incompatibilities" GroupName="RelFilter" Classes="f-pill" Margin="0,0,5,5"
                                     IsChecked="{Binding IsFilterIncomp, Mode=OneWay}"
                                     Command="{Binding SetRelationFilterCommand}" CommandParameter="Incompatibilities"/>
                        <RadioButton Content="Overridden / Disabled" GroupName="RelFilter" Classes="f-pill" Margin="0,0,0,5"
                                     IsChecked="{Binding IsFilterInactive, Mode=OneWay}"
                                     Command="{Binding SetRelationFilterCommand}" CommandParameter="Inactive"/>
                    </WrapPanel>

                    <Border Classes="surface-box" IsVisible="{Binding HasNoFilteredRelations}" Padding="16,20">
                        <TextBlock Text="No rules match this filter."
                                   HorizontalAlignment="Center" FontStyle="Italic"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                    </Border>

                    <!-- Unified Rule Cards -->
                    <ItemsControl ItemsSource="{Binding FilteredRelations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModRelationRowViewModel">
                                <Border Classes="rule-card"
                                        Classes.inherited="{Binding IsActiveInherited}"
                                        Classes.overridden="{Binding IsOverriddenByCustom}"
                                        Classes.disabled="{Binding IsDisabledByUser}"
                                        Margin="0,0,0,6">
                                    <Border Padding="11,8" BorderThickness="3,0,0,0"
                                            Classes.overridden-accent="{Binding IsOverriddenByCustom}">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="Border.overridden-accent">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHighlight}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal">
                                                    <!-- Origin Pill -->
                                                    <Border Classes="pill-badge"
                                                            Classes.muted="{Binding IsOfficial}"
                                                            Classes.db="{Binding IsDatabase}"
                                                            Classes.custom="{Binding IsCustom}"
                                                            Margin="0,0,5,2">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushTextStrong}"/>
                                                    </Border>

                                                    <!-- Relation Pill -->
                                                    <Border Classes="pill-badge"
                                                            Classes.hard="{Binding IsHard}"
                                                            Classes.soft="{Binding IsSoftOrOrder}"
                                                            Margin="0,0,6,2">
                                                        <TextBlock Text="{Binding RelationLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Classes.strike="{Binding IsInactive}"
                                                                   Foreground="{DynamicResource BrushTextBrown950}"/>
                                                    </Border>

                                                    <!-- Target Name -->
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12.5"
                                                               Classes.strike="{Binding IsInactive}"
                                                               Foreground="{DynamicResource BrushTextBrown950}"
                                                               VerticalAlignment="Center" Margin="0,0,6,2"/>

                                                    <!-- Overridden / Disabled Badges -->
                                                    <Border Classes="pill-badge overridden" IsVisible="{Binding IsOverriddenByCustom}" Margin="0,0,4,2">
                                                        <TextBlock Text="{Binding OverriddenByText}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextBrown950}"/>
                                                    </Border>
                                                    <Border Classes="pill-badge muted" IsVisible="{Binding IsDisabledByUser}" Margin="0,0,4,2">
                                                        <TextBlock Text="Disabled by user" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding TargetPackageId}" Classes="mono-sub"/>

                                                <TextBlock Text="{Binding Comment, StringFormat='&quot;{0}&quot;'}"
                                                           FontSize="11" FontStyle="Italic"
                                                           Foreground="{DynamicResource BrushTextStrong}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasComment}"/>
                                            </StackPanel>

                                            <!-- Row Actions -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <!-- Custom Actions: Edit + Remove -->
                                                <Button Command="{Binding EditCommand}" Classes="btn-secondary btn-sm btn-icon"
                                                        IsVisible="{Binding IsCustom}" ToolTip.Tip="Edit rule">
                                                    <i:Icon Value="fa-pen" FontSize="11"/>
                                                </Button>
                                                <Button Command="{Binding RemoveCommand}" Classes="btn-danger-ghost btn-sm btn-icon"
                                                        IsVisible="{Binding IsCustom}" ToolTip.Tip="Remove rule">
                                                    <i:Icon Value="fa-trash" FontSize="11"/>
                                                </Button>

                                                <!-- Inherited Actions: Disable / Enable -->
                                                <Button Content="{Binding ToggleDisableText}" Command="{Binding ToggleDisabledCommand}"
                                                        Classes="btn-secondary btn-sm"
                                                        IsVisible="{Binding CanToggleDisabled}"/>

                                                <Border Classes="pill-badge muted" IsVisible="{Binding IsDependency}">
                                                    <TextBlock Text="Required" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </Border>

                                                <TextBlock Text="Superseded" FontSize="10.5" FontStyle="Italic"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsOverriddenByCustom}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

        </TabControl>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <Border Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Custom rules override Mod &amp; DB rules. Inherited rules can be disabled; Custom rules are removed."
                           FontSize="11" Foreground="{DynamicResource BrushTextStrong}" Opacity="0.85"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="btn" MinWidth="92" Height="31"/>
                    <Button Content="Save Customizations" Command="{Binding SaveCommand}" Classes="btn-success" MinWidth="145" Height="31"/>
                </StackPanel>
            </Grid>
        </Border>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>

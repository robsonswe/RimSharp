<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
                    xmlns:local="clr-namespace:RimSharp.Features.ModManager.Dialogs.Filter"
                    xmlns:i="https://github.com/projektanker/icons.avalonia"
                    x:Class="RimSharp.Features.ModManager.Dialogs.Filter.ModFilterDialogView"
                    x:DataType="local:ModFilterDialogViewModel"
                    x:CompileBindings="True"
                    Classes="dialog-flush"
                    Title="{Binding Title}"
                    Width="670"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.MainContent>
        <TabControl Classes="tabs-rail" Height="416">

            <!-- TAB 1: GENERAL -->
            <TabItem Header="General" Classes="rail-group" Tag="SEARCH &amp; RULES">
                <StackPanel Spacing="14">
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <TextBlock Text="General Criteria" Classes="pane-title"/>
                    </Border>

                    <!-- Search Inputs -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Name / PackageId" Classes="field-label"/>
                            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                     Classes="input"
                                     Height="30"
                                     PlaceholderText="e.g. Harmony"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Author" Classes="field-label"/>
                            <TextBox Text="{Binding AuthorFilterText, Mode=TwoWay}"
                                     Classes="input"
                                     Height="30"
                                     PlaceholderText="e.g. Brrainz"/>
                        </StackPanel>
                    </Grid>

                    <!-- State & Content -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="State &amp; Content" Classes="field-label"/>

                        <!-- Is Supported -->
                        <Border Classes="surface-box" Padding="11,7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Is Supported?" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextBrown950}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="tri-seg">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Any" GroupName="IsSupported" Classes="tri-btn tri-any"
                                                     IsChecked="{Binding IsSupportedFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Null}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="IsSupported|Null"/>
                                        <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                        <RadioButton Content="Yes" GroupName="IsSupported" Classes="tri-btn tri-yes"
                                                     IsChecked="{Binding IsSupportedFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=True}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="IsSupported|True"/>
                                        <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                        <RadioButton Content="No" GroupName="IsSupported" Classes="tri-btn tri-no"
                                                     IsChecked="{Binding IsSupportedFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=False}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="IsSupported|False"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Is Favorite -->
                        <Border Classes="surface-box" Padding="11,7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Is Favorite?" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextBrown950}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="tri-seg">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Any" GroupName="IsFavorite" Classes="tri-btn tri-any"
                                                     IsChecked="{Binding IsFavoriteFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Null}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="IsFavorite|Null"/>
                                        <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                        <RadioButton Content="Yes" GroupName="IsFavorite" Classes="tri-btn tri-yes"
                                                     IsChecked="{Binding IsFavoriteFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=True}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="IsFavorite|True"/>
                                        <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                        <RadioButton Content="No" GroupName="IsFavorite" Classes="tri-btn tri-no"
                                                     IsChecked="{Binding IsFavoriteFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=False}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="IsFavorite|False"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Has Assemblies -->
                        <Border Classes="surface-box" Padding="11,7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Has Assemblies (.dll)?" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextBrown950}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="tri-seg">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Any" GroupName="HasAssemblies" Classes="tri-btn tri-any"
                                                     IsChecked="{Binding HasAssembliesFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Null}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="HasAssemblies|Null"/>
                                        <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                        <RadioButton Content="Yes" GroupName="HasAssemblies" Classes="tri-btn tri-yes"
                                                     IsChecked="{Binding HasAssembliesFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=True}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="HasAssemblies|True"/>
                                        <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                        <RadioButton Content="No" GroupName="HasAssemblies" Classes="tri-btn tri-no"
                                                     IsChecked="{Binding HasAssembliesFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=False}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="HasAssemblies|False"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Has Textures -->
                        <Border Classes="surface-box" Padding="11,7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Has Textures?" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource BrushTextBrown950}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="tri-seg">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Any" GroupName="HasTextures" Classes="tri-btn tri-any"
                                                     IsChecked="{Binding HasTexturesFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Null}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="HasTextures|Null"/>
                                        <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                        <RadioButton Content="Yes" GroupName="HasTextures" Classes="tri-btn tri-yes"
                                                     IsChecked="{Binding HasTexturesFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=True}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="HasTextures|True"/>
                                        <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                        <RadioButton Content="No" GroupName="HasTextures" Classes="tri-btn tri-no"
                                                     IsChecked="{Binding HasTexturesFilter, Mode=OneWay, Converter={StaticResource NullToBoolConverter}, ConverterParameter=False}"
                                                     Command="{Binding SetFilterPropertyCommand}" CommandParameter="HasTextures|False"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- TAB 2: MOD TYPES -->
            <TabItem Header="Mod Types" Classes="rail-group" Tag="CATEGORIES">
                <StackPanel Spacing="12">
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Mod Types" Classes="pane-title" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Leave all unchecked to show all" Classes="field-hint" VerticalAlignment="Center" Opacity="0.85"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding AvailableModTypes}" x:CompileBindings="False" Margin="-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Classes="check-card" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="9" Height="9" CornerRadius="2"
                                                BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1"
                                                Background="{Binding Item, Converter={StaticResource ModTypeToColorConverter}}"/>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{DynamicResource BrushTextBrown950}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- TAB 3: TAGS -->
            <TabItem Header="Tags">
                <StackPanel Spacing="12">
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <TextBlock Text="Local Tags" Classes="pane-title"/>
                    </Border>

                    <TextBlock Classes="field-hint"
                               Text="Mods must match at least one Include tag (if any) and none of the Exclude tags."/>

                    <Border Classes="surface-box" IsVisible="{Binding HasNoTags}" Padding="16,20">
                        <TextBlock Text="No tags found. Tag your mods via right-click → Customize Mod, then reopen this filter."
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   FontStyle="Italic" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                    </Border>

                    <ItemsControl x:Name="TagsList" ItemsSource="{Binding AvailableTags}" IsVisible="{Binding !HasNoTags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:TriStateFilterItemViewModel">
                                <Border Classes="surface-box" Padding="11,7" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource BrushTextBrown950}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Classes="tri-seg">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Any" Classes="tri-btn tri-any"
                                                             GroupName="{Binding Item, StringFormat='Tag_{0}'}"
                                                             IsChecked="{Binding IsAny, Mode=OneWay}"
                                                             Command="{Binding #TagsList.((local:ModFilterDialogViewModel)DataContext).SetFilterModeCommand}"
                                                             CommandParameter="{Binding ParamAny}"/>
                                                <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                                <RadioButton Content="Include" Classes="tri-btn tri-yes"
                                                             GroupName="{Binding Item, StringFormat='Tag_{0}'}"
                                                             IsChecked="{Binding IsInclude, Mode=OneWay}"
                                                             Command="{Binding #TagsList.((local:ModFilterDialogViewModel)DataContext).SetFilterModeCommand}"
                                                             CommandParameter="{Binding ParamInclude}"/>
                                                <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                                <RadioButton Content="Exclude" Classes="tri-btn tri-no"
                                                             GroupName="{Binding Item, StringFormat='Tag_{0}'}"
                                                             IsChecked="{Binding IsExclude, Mode=OneWay}"
                                                             Command="{Binding #TagsList.((local:ModFilterDialogViewModel)DataContext).SetFilterModeCommand}"
                                                             CommandParameter="{Binding ParamExclude}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- TAB 4: VERSIONS -->
            <TabItem Header="Versions">
                <StackPanel Spacing="12">
                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                        <TextBlock Text="Supported Game Versions" Classes="pane-title"/>
                    </Border>

                    <ItemsControl x:Name="VersionsList" ItemsSource="{Binding AvailableVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:TriStateFilterItemViewModel">
                                <Border Classes="surface-box" Padding="11,7" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{DynamicResource BrushTextBrown950}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Classes="tri-seg">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Any" Classes="tri-btn tri-any"
                                                             GroupName="{Binding Item, StringFormat='Ver_{0}'}"
                                                             IsChecked="{Binding IsAny, Mode=OneWay}"
                                                             Command="{Binding #VersionsList.((local:ModFilterDialogViewModel)DataContext).SetFilterModeCommand}"
                                                             CommandParameter="{Binding ParamAny}"/>
                                                <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                                <RadioButton Content="Include" Classes="tri-btn tri-yes"
                                                             GroupName="{Binding Item, StringFormat='Ver_{0}'}"
                                                             IsChecked="{Binding IsInclude, Mode=OneWay}"
                                                             Command="{Binding #VersionsList.((local:ModFilterDialogViewModel)DataContext).SetFilterModeCommand}"
                                                             CommandParameter="{Binding ParamInclude}"/>
                                                <Border Width="1" Background="{DynamicResource BrushBorderSubtle}"/>
                                                <RadioButton Content="Exclude" Classes="tri-btn tri-no"
                                                             GroupName="{Binding Item, StringFormat='Ver_{0}'}"
                                                             IsChecked="{Binding IsExclude, Mode=OneWay}"
                                                             Command="{Binding #VersionsList.((local:ModFilterDialogViewModel)DataContext).SetFilterModeCommand}"
                                                             CommandParameter="{Binding ParamExclude}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

        </TabControl>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <Border Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Command="{Binding ClearCommand}"
                        Classes="btn-danger-ghost"
                        HorizontalAlignment="Left"
                        Height="31">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <i:Icon Value="fa-rotate-left" FontSize="11"/>
                        <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Classes="btn"
                            MinWidth="92" Height="31"/>
                    <Button Content="Apply Filters"
                            Command="{Binding ApplyCommand}"
                            Classes="btn-success"
                            MinWidth="105" Height="31"/>
                </StackPanel>
            </Grid>
        </Border>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>
<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
        xmlns:vm="clr-namespace:RimSharp.Features.LogViewer.ViewModels"
        x:Class="RimSharp.Features.LogViewer.Views.LogViewerView"
        mc:Ignorable="d"
        x:DataType="vm:LogViewerViewModel"
        Title="{Binding Title}"
        Width="960"
        Height="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.MainContent>
        <Border Classes="panel">
            <TabControl Margin="15,10">
                <TabItem Header="Log View">
                    <Grid Margin="0,6" RowDefinitions="Auto,Auto,Auto,Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Player.log Viewer"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Load Game Log"
                            Command="{Binding LoadDefaultCommand}"
                            Classes="btn"
                            MinWidth="110" Height="30"/>
                    <Button Content="Open..."
                            Command="{Binding LoadFileCommand}"
                            Classes="btn"
                            MinWidth="80" Height="30"/>
                    <Button Content="Export"
                            Command="{Binding ExportCommand}"
                            Classes="btn"
                            MinWidth="80" Height="30"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Classes="btn"
                            MinWidth="80" Height="30"/>
                    <ComboBox ItemsSource="{Binding SourceOptions}"
                              SelectedItem="{Binding SelectedSourceOption, Mode=TwoWay}"
                              IsEnabled="{Binding HasMultipleSources}"
                              MinWidth="200"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding LineCountText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <ComboBox ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilterOption}"
                              MinWidth="140">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Width="180"
                             PlaceholderText="Search..."
                             TextChanged="OnLineFilterTextChanged"/>
                    <CheckBox Content="Collapse repeats"
                              IsChecked="{Binding CollapseRepeats, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,6,0,0" Spacing="2">
                    <TextBlock Text="{Binding PathText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding SizeText}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding ModifiedText}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>

                <Border Grid.Row="4"
                        Height="300"
                        Margin="0,8,0,0"
                        Padding="6,4"
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsLoading}"
                                     Height="4"
                                     Margin="0,-4,0,0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      AllowAutoHide="False">
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                   TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No log loaded"
                                   IsVisible="{Binding ShowLogPlaceholder}"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                    </Grid>
                </Border>
            </Grid>
                </TabItem>

                <TabItem Header="Troubleshooter">
                    <Grid Margin="0,6" RowDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Diagnostics.IssueSummaryText}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Grid.Row="1"
                                   Text="Pattern hits over the log, deduplicated and counted; line numbers refer to the log file. This tab explains what the log says — mod-list problems themselves (duplicates, missing dependencies, incompatibilities, load order) are checked live in Maintenance and the Sort button."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                        <ListBox Grid.Row="2"
                                 Margin="0,6,0,0"
                                 ItemsSource="{Binding Diagnostics.Issues}"
                                 SelectedItem="{Binding Diagnostics.SelectedIssue, Mode=TwoWay}"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding SeverityLabel}"
                                                   Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                   Width="70"/>
                                        <TextBlock Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Count}"
                                                   Foreground="{DynamicResource BrushTextMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="3"
                                Margin="0,6,0,0"
                                Padding="8"
                                BorderBrush="{DynamicResource BrushBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0"
                                           Text="{Binding Diagnostics.IssueDetailTitle}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Grid.Row="1"
                                           Margin="0,4,0,0"
                                           Text="{Binding Diagnostics.IssueDetail}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Summary">
                    <Grid Margin="0,6" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0"
                                   Text="What this log says about itself"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <ItemsControl Grid.Row="1"
                                      Margin="0,6,0,0"
                                      ItemsSource="{Binding Diagnostics.SummaryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <Button Content="Close"
                Command="{Binding CloseCommand}"
                Classes="btn"
                HorizontalAlignment="Right"
                MinWidth="100"
                Height="32"/>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>

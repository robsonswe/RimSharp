<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
        xmlns:vm="clr-namespace:RimSharp.Features.LogViewer.ViewModels"
        x:Class="RimSharp.Features.LogViewer.Views.LogViewerView"
        mc:Ignorable="d"
        x:DataType="vm:LogViewerViewModel"
        Title="{Binding Title}"
        Width="960"
        Height="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.MainContent>
        <Border Classes="panel">
            <Grid Margin="15,10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Player.log Viewer"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Load Game Log"
                            Command="{Binding LoadDefaultCommand}"
                            Classes="btn"
                            MinWidth="110" Height="30"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Classes="btn"
                            MinWidth="80" Height="30"/>
                    <TextBlock Text="{Binding LineCountText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <ComboBox ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilterOption}"
                              MinWidth="140">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Width="180"
                             Watermark="Search..."
                             TextChanged="OnLineFilterTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,6,0,0" Spacing="2">
                    <TextBlock Text="{Binding PathText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding SizeText}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>

                <UniformGrid Grid.Row="4" Columns="4" Margin="0,8,0,0">
                    <Button Content="{Binding Stats.TotalLines, StringFormat='Total Lines: {0}'}"
                            Command="{Binding SelectFilterCommand}"
                            CommandParameter="{Binding FilterOptions[0]}"
                            Classes="btn" Margin="2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding Stats.AllIssues, StringFormat='All Issues: {0}'}"
                            Command="{Binding SelectFilterCommand}"
                            CommandParameter="{Binding FilterOptions[7]}"
                            Classes="btn" Margin="2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding Stats.Errors, StringFormat='Errors: {0}'}"
                            Command="{Binding SelectFilterCommand}"
                            CommandParameter="{Binding FilterOptions[5]}"
                            Classes="btn" Margin="2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding Stats.Exceptions, StringFormat='Exceptions: {0}'}"
                            Command="{Binding SelectFilterCommand}"
                            CommandParameter="{Binding FilterOptions[6]}"
                            Classes="btn" Margin="2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding Stats.Warnings, StringFormat='Warnings: {0}'}"
                            Command="{Binding SelectFilterCommand}"
                            CommandParameter="{Binding FilterOptions[4]}"
                            Classes="btn" Margin="2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding Stats.ModIssues, StringFormat='Mod Issues: {0}'}"
                            Command="{Binding SelectFilterCommand}"
                            CommandParameter="{Binding FilterOptions[3]}"
                            Classes="btn" Margin="2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding Stats.Keybinds, StringFormat='Keybinds: {0}'}"
                            Command="{Binding SelectFilterCommand}"
                            CommandParameter="{Binding FilterOptions[2]}"
                            Classes="btn" Margin="2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding Stats.Infos, StringFormat='Infos: {0}'}"
                            Command="{Binding SelectFilterCommand}"
                            CommandParameter="{Binding FilterOptions[1]}"
                            Classes="btn" Margin="2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                </UniformGrid>

                <Border Grid.Row="5"
                        Height="300"
                        Margin="0,8,0,0"
                        Padding="6,4"
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      AllowAutoHide="False">
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                                   TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No log loaded"
                                   IsVisible="{Binding ShowLogPlaceholder}"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextMuted}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <Button Content="Close"
                Command="{Binding CloseCommand}"
                Classes="btn"
                HorizontalAlignment="Right"
                MinWidth="100"
                Height="32"/>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>

<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
        xmlns:vm="clr-namespace:RimSharp.Features.LogViewer.ViewModels"
        x:Class="RimSharp.Features.LogViewer.Views.LogViewerView"
        mc:Ignorable="d"
        x:DataType="vm:LogViewerViewModel"
        Title="{Binding Title}"
        Width="960"
        Height="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.MainContent>
        <Border Classes="panel">
            <Grid Margin="15,10" RowDefinitions="Auto,Auto,Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Player.log Viewer"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Load Game Log"
                            Command="{Binding LoadDefaultCommand}"
                            Classes="btn"
                            MinWidth="110" Height="30"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Classes="btn"
                            MinWidth="80" Height="30"/>
                    <TextBlock Text="{Binding LineCountText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,6,0,0" Spacing="2">
                    <TextBlock Text="{Binding PathText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding SizeText}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,8,0,0"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                               TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <Button Content="Close"
                Command="{Binding CloseCommand}"
                Classes="btn"
                HorizontalAlignment="Right"
                MinWidth="100"
                Height="32"/>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>

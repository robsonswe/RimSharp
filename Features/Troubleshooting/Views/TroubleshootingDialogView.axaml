<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:i="https://github.com/projektanker/icons.avalonia"
              xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
              xmlns:vm="clr-namespace:RimSharp.Features.Troubleshooting.ViewModels"
              mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
              x:Class="RimSharp.Features.Troubleshooting.Views.TroubleshootingDialogView"
              x:DataType="vm:TroubleshootingViewModel"
              x:Name="DialogRoot"
              Width="900" Height="700"
              MinWidth="780" MinHeight="520"
              CanResize="True"
              WindowStartupLocation="CenterOwner"
              Title="{Binding Title}">

    <dialogs:BaseDialog.MainContent>
        <Border Classes="panel" Padding="0" ClipToBounds="True">
            <Border.Styles>

                <Style Selector="Border.step">
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="CornerRadius" Value="12"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Opacity" Value="0.55"/>
                </Style>
                <Style Selector="Border.step.active">
                    <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <Style Selector="Border.step TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
                </Style>
                <Style Selector="Border.step.active TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
                </Style>
                <Style Selector="TextBlock.step-sep">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
                </Style>

                <Style Selector="Border.card">
                    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="14"/>
                </Style>
                <Style Selector="Border.card.selected">
                    <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                </Style>
                <Style Selector="Border.note">
                    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="12,10"/>
                </Style>

                <Style Selector="Border.rail">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="Border.rail.warn">
                    <Setter Property="Background" Value="{DynamicResource BrushStateWarning}"/>
                </Style>
                <Style Selector="Border.rail.error">
                    <Setter Property="Background" Value="{DynamicResource BrushStateDanger}"/>
                </Style>

                <Style Selector="Border.chip">
                    <Setter Property="Padding" Value="6,1"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style Selector="Border.chip TextBlock">
                    <Setter Property="FontSize" Value="10.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
                </Style>
                <Style Selector="Border.chip.soft">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
                <Style Selector="Border.chip.soft TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
                <Style Selector="Border.chip.error">
                    <Setter Property="Background" Value="{DynamicResource BrushStateDanger}"/>
                </Style>
                <Style Selector="Border.chip.error.warn">
                    <Setter Property="Background" Value="{DynamicResource BrushStateWarning}"/>
                </Style>

                <Style Selector="Button.symptom">
                    <Setter Property="Padding" Value="14,12"/>
                    <Setter Property="Margin" Value="0,0,10,10"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="Bg"
                                    Background="{DynamicResource BrushBgSurface}"
                                    BorderBrush="{DynamicResource BrushBorderDefault}"
                                    BorderThickness="1" CornerRadius="4">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="Button.symptom:pointerover /template/ Border#Bg">
                    <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                </Style>
                <Style Selector="Button.symptom:pressed /template/ Border#Bg">
                    <Setter Property="Background" Value="{DynamicResource BrushBgHighlight}"/>
                </Style>
                <Style Selector="Button.symptom:disabled">
                    <Setter Property="Opacity" Value="0.6"/>
                </Style>

                <Style Selector="Button.ghost">
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="Bg" Background="Transparent" CornerRadius="3">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  Padding="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="Button.ghost:pointerover /template/ Border#Bg">
                    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
                </Style>
                <Style Selector="Button.ghost:disabled">
                    <Setter Property="Opacity" Value="0.5"/>
                </Style>

                <Style Selector="Button.primary">
                    <Setter Property="MinWidth" Value="170"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="16,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>

                <Style Selector="CheckBox.fix">
                    <Setter Property="Padding" Value="10,0,0,0"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                </Style>

                <Style Selector="Border.spin">
                    <Style.Animations>
                        <Animation Duration="0:0:1.2" IterationCount="Infinite">
                            <KeyFrame Cue="0%">
                                <Setter Property="RotateTransform.Angle" Value="0"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="RotateTransform.Angle" Value="360"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>

                <Style Selector="Border.inline-toast">
                    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Margin" Value="20,8,20,8"/>
                    <Setter Property="ClipToBounds" Value="True"/>
                </Style>

                <Style Selector="Border.dock">
                    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                    <Setter Property="Padding" Value="20,10"/>
                </Style>
            </Border.Styles>

            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

                <Border Grid.Row="0" Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderMuted}" BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Classes="step" Classes.active="{Binding ShowSymptomList}">
                            <TextBlock Text="1  Problem"/>
                        </Border>
                        <TextBlock Classes="step-sep" Text="›"/>
                        <Border Classes="step" Classes.active="{Binding ShowCausesPage}">
                            <TextBlock Text="2  Reasons"/>
                        </Border>
                        <TextBlock Classes="step-sep" Text="›"/>
                        <Border Classes="step" Classes.active="{Binding ShowChecksRunning}">
                            <TextBlock Text="3  Check"/>
                        </Border>
                        <TextBlock Classes="step-sep" Text="›"/>
                        <Border Classes="step" Classes.active="{Binding ShowSolutionsPage}">
                            <TextBlock Text="4  Choose fixes"/>
                        </Border>
                        <TextBlock Classes="step-sep" Text="›"/>
                        <Border Classes="step" Classes.active="{Binding ShowActionRunning}">
                            <TextBlock Text="5  Applying"/>
                        </Border>
                        <TextBlock Classes="step-sep" Text="›"/>
                        <Border Classes="step" Classes.active="{Binding ShowActionResults}">
                            <TextBlock Text="6  Results"/>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" AllowAutoHide="False" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20,18,20,18">

                        <StackPanel IsVisible="{Binding ShowSymptomList}" Spacing="14">
                            <TextBlock Text="What's going wrong?" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextStrong}"/>

                            <ItemsControl ItemsSource="{Binding VisibleSymptoms}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TroubleshootingSymptomDescriptor">
                                        <Button Classes="symptom"
                                                Command="{Binding DataContext.SelectSymptomCommand, ElementName=DialogRoot}"
                                                CommandParameter="{Binding}">
                                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}"
                                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource BrushTextStrong}"/>
                                                <i:Icon Grid.Row="0" Grid.Column="1" Value="fa-chevron-right" FontSize="12"
                                                        Margin="10,4,0,0" VerticalAlignment="Top"
                                                        Foreground="{DynamicResource BrushTextMuted}"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="chip"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        IsVisible="{Binding RequiresSteam}">
                                                    <TextBlock Text="Steam only"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding ShowCausesPage}" Spacing="16">
                            <Button Classes="ghost" Command="{Binding PickDifferentProblemCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <i:Icon Value="fa-chevron-left" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="All problems" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding CurrentSymptomTitle}" FontSize="22" FontWeight="Bold"
                                           TextWrapping="Wrap" Foreground="{DynamicResource BrushTextStrong}"/>
                                <TextBlock Text="{Binding CurrentSymptomDescription}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Possible reasons" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextStrong}"/>
                                        <TextBlock Text="General possibilities, not a diagnosis of your install."
                                                   FontSize="11.5" TextWrapping="Wrap" Opacity="0.9"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding CurrentSymptomCauses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                                    <Ellipse Grid.Column="0" Width="6" Height="6" Margin="2,6,12,0"
                                                             VerticalAlignment="Top"
                                                             Fill="{DynamicResource BrushBgAction}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border IsVisible="{Binding ShowChecksRunning}" Classes="card"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="32,28" MinWidth="420" Margin="0,40,0,0">
                            <StackPanel Spacing="14" HorizontalAlignment="Center">
                                <Border Classes="spin" Width="28" Height="28" HorizontalAlignment="Center"
                                        RenderTransform="rotate(0deg)" Background="Transparent">
                                    <i:Icon Value="fa-circle-notch" FontSize="26"
                                            Foreground="{DynamicResource BrushBgAction}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentSymptomTitle}" FontSize="12" Opacity="0.85"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding ScanCheck}" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextStrong}"/>
                                <ProgressBar IsIndeterminate="True" Height="4" Width="260"
                                             Background="{DynamicResource BrushBgPanel}"
                                             Foreground="{DynamicResource BrushBgAction}"/>
                                <Button Content="Cancel" Command="{Binding PickDifferentProblemCommand}"
                                        Classes="btn" Height="30" Padding="12,3"
                                        HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel IsVisible="{Binding ShowSolutionsPage}" Spacing="14">
                            <Button Classes="ghost" Command="{Binding PickDifferentProblemCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <i:Icon Value="fa-chevron-left" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="All problems" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding CurrentSymptomTitle}" FontSize="22" FontWeight="Bold"
                                           TextWrapping="Wrap" Foreground="{DynamicResource BrushTextStrong}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasFindings}">
                                    <i:Icon Value="fa-clipboard-check" FontSize="12" VerticalAlignment="Center"
                                            Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding ChecksSummary}" FontSize="12" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border IsVisible="{Binding !HasFindings}" Classes="note">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <i:Icon Grid.Column="0" Value="fa-circle-info" FontSize="18"
                                            VerticalAlignment="Top" Margin="0,2,0,0"
                                            Foreground="{DynamicResource BrushBgAction}"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding NoFindingsTitle}" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource BrushTextStrong}"/>
                                        <TextBlock Text="{Binding NoFindingsNote}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Fixes" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource BrushTextStrong}"/>

                            <ItemsControl ItemsSource="{Binding SolutionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SolutionRowViewModel">
                                        <Border Classes="card" Classes.selected="{Binding IsSelected}"
                                                Padding="0" Margin="0,0,0,8" ClipToBounds="True">
                                            <Grid ColumnDefinitions="4,*">
                                                <Border Grid.Column="0" Classes="rail"
                                                        Classes.warn="{Binding SeverityBadge, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Warning}"
                                                        Classes.error="{Binding SeverityBadge, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Error}"/>
                                                <CheckBox Grid.Column="1" Classes="fix" IsChecked="{Binding IsSelected}"
                                                          Margin="14,12,14,12" VerticalAlignment="Center">
                                                    <StackPanel Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource BrushTextStrong}"/>
                                                            <Border Classes="chip error"
                                                                    Classes.warn="{Binding SeverityBadge, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Warning}"
                                                                    IsVisible="{Binding IsFindingDriven}">
                                                                <TextBlock Text="{Binding SeverityBadge}"/>
                                                            </Border>
                                                            <Border Classes="chip soft" IsVisible="{Binding IsDestructive}">
                                                                <TextBlock Text="Destructive"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <Border IsVisible="{Binding IsFindingDriven}"
                                                                Background="{DynamicResource BrushBgPanel}"
                                                                CornerRadius="3" Padding="8,5">
                                                            <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource BrushTextStrong}">
                                                                <Run Text="Found: " FontWeight="SemiBold"/>
                                                                <Run Text="{Binding FindingDetail}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </CheckBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border IsVisible="{Binding ShowActionRunning}" Classes="card"
                                BorderBrush="{DynamicResource BrushBgAction}" BorderThickness="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="32,28" MinWidth="420" Margin="0,40,0,0">
                            <StackPanel Spacing="14" HorizontalAlignment="Center">
                                <Border Classes="spin" Width="28" Height="28" HorizontalAlignment="Center"
                                        RenderTransform="rotate(0deg)" Background="Transparent">
                                    <i:Icon Value="fa-circle-notch" FontSize="26"
                                            Foreground="{DynamicResource BrushBgAction}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Applying fix" FontSize="12" Opacity="0.85"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding ActionRunningTitle}" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextStrong}"/>
                                <ProgressBar IsIndeterminate="True" Height="4" Width="260"
                                             Background="{DynamicResource BrushBgPanel}"
                                             Foreground="{DynamicResource BrushBgAction}"/>
                                <TextBlock Text="Keep this window open until it finishes."
                                           FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel IsVisible="{Binding ShowActionResults}" Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Fix run finished" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextStrong}"/>
                                <TextBlock Text="Here's what happened with each fix."
                                           FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ActionResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionResultViewModel">
                                        <Border Classes="card" Padding="0" Margin="0,0,0,8" ClipToBounds="True">
                                            <Grid ColumnDefinitions="4,Auto,*">
                                                <Border Grid.Column="0"
                                                        Background="{Binding StatusColor, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusIcon}" FontSize="22" FontWeight="Bold"
                                                           Margin="16,0,4,0" VerticalAlignment="Center"
                                                           Foreground="{Binding StatusColor, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                                                <StackPanel Grid.Column="2" Spacing="3" Margin="10,12,14,12" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActionTitle}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" Classes="dock" IsVisible="{Binding ShowCausesPage}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Text="Check your setup to see which of these apply."
                                   FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Button Grid.Column="1" Content="Check this problem"
                                Command="{Binding RunChecksCommand}"
                                Classes="btn primary"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Classes="dock" IsVisible="{Binding ShowSolutionsPage}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock IsVisible="{Binding !HasSelectedSolutions}"
                                       Text="Select the fixes you want to run."
                                       FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock IsVisible="{Binding HasSelectedSolutions}"
                                       Text="Selected fixes run immediately, with no further confirmation."
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextStrong}"/>
                        </Grid>
                        <Button Grid.Column="1" Content="Proceed with fixes"
                                Command="{Binding ProceedWithFixesCommand}"
                                Classes="btn primary"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Classes="dock" IsVisible="{Binding ShowActionResults}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Text="Facing another issue?" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource BrushTextStrong}"/>
                        <Button Grid.Column="1" Content="Pick another problem"
                                Command="{Binding DismissActionResultsCommand}"
                                Classes="btn primary"/>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="5" ItemsSource="{Binding Toasts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InlineToastViewModel">
                            <Border Classes="inline-toast">
                                <Grid ColumnDefinitions="4,*,Auto">
                                    <Border Grid.Column="0"
                                            Background="{Binding BrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                                    <StackPanel Grid.Column="1" Margin="12,8" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextStrong}"/>
                                        <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✕" FontSize="11"
                                            Command="{Binding DataContext.DismissToastCommand, ElementName=DialogRoot}"
                                            CommandParameter="{Binding}"
                                            Classes="btn" Height="24" MinWidth="24" Width="24"
                                            VerticalAlignment="Center" Padding="0" Margin="0,0,10,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Close" Command="{Binding CloseCommand}"
                    Classes="btn" Height="32" MinWidth="90"/>
        </StackPanel>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>

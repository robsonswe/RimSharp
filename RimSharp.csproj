<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <UseWindowsForms Condition="'$(TargetFramework)'=='net8.0-windows'">true</UseWindowsForms>
    <BuiltInComInteropSupport Condition="'$(TargetFramework)'=='net8.0-windows'">true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="'$(TargetFramework)'=='net8.0-windows'">app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode Condition="'$(TargetFramework)'=='net8.0-windows'">PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>RimSharp</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);RimSharp.Tests\**</DefaultItemExcludes>
    <!-- Avalonia 12 enables compiled bindings by default; keep 11.x reflection-binding behavior. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RimSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="icon.ico" />
    <AvaloniaResource Include="Resources\Fonts\Noto_Sans\static\NotoSans-Regular.ttf" />
    <AvaloniaResource Include="Resources\Fonts\Noto_Sans\static\NotoSans-SemiBold.ttf" />
    <AvaloniaResource Include="Resources\Fonts\Noto_Sans\static\NotoSans-Bold.ttf" />
    <AvaloniaResource Include="Resources\Fonts\IBM_Plex_Mono\IBMPlexMono-Regular.ttf" />
    <AvaloniaResource Include="Resources\Fonts\IBM_Plex_Mono\IBMPlexMono-SemiBold.ttf" />
    <AvaloniaResource Include="Resources\Fonts\IBM_Plex_Mono\IBMPlexMono-Bold.ttf" />
    <Content Include="Resources\classdata.tpk">
      <Link>classdata.tpk</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0" Condition="'$(Configuration)'=='Debug'" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2365.46" Condition="'$(TargetFramework)'=='net8.0-windows'" />
    <PackageReference Include="PInvoke.User32" Version="0.7.124" Condition="'$(TargetFramework)'=='net8.0-windows'" />
    <PackageReference Include="Optris.Icons.Avalonia" Version="12.0.7" />
    <PackageReference Include="Optris.Icons.Avalonia.FontAwesome" Version="12.0.7" />
    <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.7" />
    <PackageReference Include="QuikGraph" Version="2.5.0" />
    <PackageReference Include="System.Management" Version="8.0.0" Condition="'$(TargetFramework)'=='net8.0-windows'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net8.0'">
    <Compile Remove="Features\WorkshopDownloader\Components\Browser\WindowsBrowserFactory.cs" />
    <Compile Remove="Features\WorkshopDownloader\Components\Browser\WindowsBrowserControl.cs" />
    <Compile Remove="Core\Services\WindowsSystemInfoService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Rules\db\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Lists\**\*" Condition="Exists('Lists\**\*')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <DefaultManifestJsonContent>{}</DefaultManifestJsonContent>
    <DefaultRulesJsonContent>{"rules":{}}</DefaultRulesJsonContent>
    <DefaultDbJsonContent>{"mods":{}}</DefaultDbJsonContent>
    <DefaultReplacementsJsonContent>{"mods":{}}</DefaultReplacementsJsonContent>
  </PropertyGroup>

  <Target Name="EnsureLocalDataFilesExist" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(ProjectDir)Rules\db" Condition="!Exists('$(ProjectDir)Rules\db')" />
    <WriteLinesToFile File="$(ProjectDir)Rules\db\manifest.json" Lines="$(DefaultManifestJsonContent)" Overwrite="false" Condition="!Exists('$(ProjectDir)Rules\db\manifest.json')" />
    <WriteLinesToFile File="$(ProjectDir)Rules\db\rules.json" Lines="$(DefaultRulesJsonContent)" Overwrite="false" Condition="!Exists('$(ProjectDir)Rules\db\rules.json')" />
    <WriteLinesToFile File="$(ProjectDir)Rules\db\db.json" Lines="$(DefaultDbJsonContent)" Overwrite="false" Condition="!Exists('$(ProjectDir)Rules\db\db.json')" />
    <WriteLinesToFile File="$(ProjectDir)Rules\db\replacements.json" Lines="$(DefaultReplacementsJsonContent)" Overwrite="false" Condition="!Exists('$(ProjectDir)Rules\db\replacements.json')" />
  </Target>

  <Target Name="SetVersionFromTextFile" BeforeTargets="BeforeBuild">
    <ReadLinesFromFile File="version.txt">
      <Output TaskParameter="Lines" ItemName="VersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <RawVersion>@(VersionLines->'%(Identity)')</RawVersion>
      <Version Condition="$(RawVersion.StartsWith('v'))">$(RawVersion.Substring(1))</Version>
      <Version Condition="!$(RawVersion.StartsWith('v'))">$(RawVersion)</Version>
    </PropertyGroup>
    <Message Importance="high" Text="Setting Assembly Version to: $(Version)" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuild">
    <MakeDir Directories="$(OutputPath)Rules\db" />
    <MakeDir Directories="$(OutputPath)Lists" />
  </Target>
</Project>

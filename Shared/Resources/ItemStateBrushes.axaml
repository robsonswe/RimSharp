<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{StaticResource ColorBrown50Alpha30}"/>
  <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{StaticResource ColorBrown50Alpha40}"/>
  <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{StaticResource ColorBrown150}"/>
  <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{StaticResource ColorBrown150}"/>
  <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{StaticResource ColorBrown150}"/>
  <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="{StaticResource ColorBrown800}"/>
  <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="{StaticResource ColorBrown400}"/>

</ResourceDictionary>
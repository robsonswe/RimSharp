<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia">

    <!-- Base button -->
    <Style Selector="Button.btn">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <!-- Shadow/Depth Layer -->
                    <Border Name="ShadowLayer"
                            Background="{DynamicResource BrushBgActionStrong}"
                            CornerRadius="3"
                            Margin="0,1,0,0" />

                    <!-- Main Button Layer -->
                    <Border Name="ButtonBackground"
                            Background="{DynamicResource BrushBgAction}"
                            BorderBrush="{DynamicResource BrushBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.btn:pointerover /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
    </Style>

    <Style Selector="Button.btn:pressed /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgActionStrong}"/>
        <Setter Property="Margin" Value="0,1,0,-1"/>
    </Style>

    <Style Selector="Button.btn:disabled /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Button.btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>

    <!-- Save Button Style -->
    <Style Selector="Button.btn-success">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="ShadowLayer"
                            Background="{DynamicResource BrushBgSuccess}"
                            CornerRadius="3"
                            Margin="0,1,0,0" />
                    <Border Name="ButtonBackground"
                            Background="{DynamicResource BrushBgSuccess}"
                            BorderBrush="{DynamicResource BrushBorderSuccess}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.btn-success:pointerover /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgSuccessHover}"/>
    </Style>

    <Style Selector="Button.btn-success:pressed /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgSuccess}"/>
        <Setter Property="Margin" Value="0,1,0,-1"/>
    </Style>

    <!-- Run Button Style -->
    <Style Selector="Button.btn-danger">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="ShadowLayer"
                            Background="{DynamicResource BrushBgDanger}"
                            CornerRadius="3"
                            Margin="0,1,0,0" />
                    <Border Name="ButtonBackground"
                            Background="{DynamicResource BrushBgDanger}"
                            BorderBrush="{DynamicResource BrushBorderError}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.btn-danger:pointerover /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgDangerHover}"/>
    </Style>

    <Style Selector="Button.btn-danger:pressed /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgDanger}"/>
        <Setter Property="Margin" Value="0,1,0,-1"/>
    </Style>

    <!-- Tab Buttons Style -->
    <Style Selector="Button.btn-tab">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="ButtonBackground"
                        Background="{DynamicResource BrushBgAccent}"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.btn-tab:pointerover /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>
    <Style Selector="Button.btn-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>

    <Style Selector="Button.btn-tab.active /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
    </Style>
    <Style Selector="Button.btn-tab.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>

    <!-- Dropdown button style (MenuItem as header) -->
    <Style Selector="MenuItem.menu-dropdown">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <!-- Shadow Layer -->
                    <Border Name="ButtonShadow"
                            Background="{DynamicResource BrushBgActionStrong}"
                            CornerRadius="3"
                            Margin="0,1,0,0" />
                    <!-- Main Button -->
                    <Border Name="ButtonBackground"
                            Background="{DynamicResource BrushBgAction}"
                            BorderBrush="{DynamicResource BrushBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Content="{TemplateBinding Header}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                            <i:Icon Value="fa-caret-down" Grid.Column="1" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="8" />
                        </Grid>
                    </Border>

                    <Popup Name="PART_Popup"
                           IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           IsLightDismissEnabled="True">
                        <Border Background="{DynamicResource BrushBgSurface}"
                                BorderBrush="{DynamicResource BrushBorderDefault}"
                                BorderThickness="1" Margin="0,3,0,0">
                            <ScrollViewer>
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="MenuItem.menu-dropdown:pointerover /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
    </Style>

    <Style Selector="MenuItem.menu-dropdown:selected /template/ Border#ButtonBackground">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
    </Style>

    <!-- Menu item style (items inside dropdown) -->
    <Style Selector="MenuItem.menu-item">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_HeaderPresenter"
                                      Content="{TemplateBinding Header}"
                                      Margin="{TemplateBinding Padding}">
                    </ContentPresenter>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="MenuItem.menu-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>

    <!-- Browser Navigation Button Style -->
    <Style Selector="Button.btn-browser-nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.btn-browser-nav:pointerover /template/ Border#ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
    </Style>

    <Style Selector="Button.btn-browser-nav:pressed /template/ Border#ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>
    <Style Selector="Button.btn-browser-nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextHighlight}"/>
    </Style>

    <Style Selector="Button.btn-browser-nav:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="Button.btn-browser-nav:disabled /template/ Border#ButtonBorder">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.btn-browser-nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>
<Style Selector="Button.btn-browser-nav:pressed /template/ Border#ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>
    <Style Selector="Button.btn-browser-nav:pressed">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushStateHighlight}"/>
    </Style>

    <Style Selector="Button.btn-browser-nav:disabled">
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>
    <Style Selector="Button.btn-browser-nav:disabled /template/ Border#ButtonBorder">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
</Styles>

    <Color x:Key="ColorAmber300Alpha28">#47F7D070</Color>
    <Color x:Key="ColorOrange500">#D98A4B</Color>
    <Color x:Key="ColorOrange600">#D09040</Color>
    <Color x:Key="ColorGoldenrodAlpha12">#20DAA520</Color>
    <Color x:Key="ColorGoldenrod">#DAA520</Color>

    <!-- Blues -->

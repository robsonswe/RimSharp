<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Application palette -->
    <Color x:Key="ColorBrown800">#4A3A2B</Color>
    <Color x:Key="ColorBrown900">#372A1F</Color>
    <Color x:Key="ColorBrown950">#18100A</Color>
    <Color x:Key="ColorBrown600">#8B7A64</Color>
    <Color x:Key="ColorBrown200">#D0C8B0</Color>
    <Color x:Key="ColorBrown400">#AA9D85</Color>
    <Color x:Key="ColorAmber300">#F7D070</Color>
    <Color x:Key="ColorGreen800">#2B4933</Color>
    <Color x:Key="ColorRed600">#9E2A2A</Color>
    <Color x:Key="ColorRed400">#D44D4D</Color>
    <Color x:Key="ColorRed700">#b52828</Color>
    <Color x:Key="ColorOrange500">#D98A4B</Color>
    <Color x:Key="ColorWhite">#FFFFFF</Color>
    <Color x:Key="ColorGray500">#BBBBBB</Color>
    <Color x:Key="ColorShadow">#222222</Color>
    <Color x:Key="ColorGreen700">#3C5F46</Color>
    <Color x:Key="ColorGreen500">#5A6F61</Color>
    <Color x:Key="ColorGreen900">#1B3021</Color>
    <Color x:Key="ColorRed500">#B13434</Color>
    <Color x:Key="ColorRed800">#7A1F1F</Color>
    <Color x:Key="ColorInputShadow">#33000000</Color>
    <Color x:Key="ColorBlack">#FF000000</Color>
    <Color x:Key="ColorBlue700">#406090</Color>    <!-- For C# / Assemblies -->
    <Color x:Key="ColorOrange600">#D09040</Color> <!-- For XML / Config only -->

    <!-- DataGrid Row Colors - white with gray alternation for better contrast -->
    <Color x:Key="ColorDataGridRowWhite">#FFFFFF</Color>       <!-- White row background -->
    <Color x:Key="ColorDataGridRowGray">#E8E8E8</Color>        <!-- Light gray alternating row -->
    <Color x:Key="ColorDataGridGridLine">#CCCCCC</Color>       <!-- Subtle grid line color -->

</ResourceDictionary>

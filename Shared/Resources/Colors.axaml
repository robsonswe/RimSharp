<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Browns & Tans -->
    <Color x:Key="ColorBrown50Alpha30">#4DF2E4C4</Color>
    <Color x:Key="ColorBrown50Alpha40">#66F2E4C4</Color>
    <Color x:Key="ColorBrown100">#DFD8C4</Color>
    <Color x:Key="ColorBrown150">#E8D8B0</Color>
    <Color x:Key="ColorBrown200">#D0C8B0</Color>
    <Color x:Key="ColorBrown200Alpha50">#80D0C8B0</Color>
    <Color x:Key="ColorBrown250">#C2B79E</Color>
    <Color x:Key="ColorBrown400">#AA9D85</Color>
    <Color x:Key="ColorBrown400Alpha40">#66AA9D85</Color>
    <Color x:Key="ColorBrown500">#9B8D74</Color>
    <Color x:Key="ColorBrown600">#8B7A64</Color>
    <Color x:Key="ColorBrown600Alpha33">#558B7A64</Color>
    <Color x:Key="ColorBrown800">#4A3A2B</Color>
    <Color x:Key="ColorBrown800Alpha12">#1F4A3A2B</Color>

    <Color x:Key="ColorWhiteAlpha18">#2EFFFFFF</Color>
    <Color x:Key="ColorDataGridRowWhite">#FFFFFF</Color>
    <Color x:Key="ColorDataGridRowGray">#E8E8E8</Color>
    <Color x:Key="ColorDataGridGridLine">#CCCCCC</Color>
    <Color x:Key="ColorGray500">#BBBBBB</Color>
    <Color x:Key="ColorGrayAlpha12">#20808080</Color>
    <Color x:Key="ColorShadow">#222222</Color>
    <Color x:Key="ColorBlack">#FF000000</Color>
    <Color x:Key="ColorInputShadow">#33000000</Color>
    <Color x:Key="ColorBlackAlpha27">#44000000</Color>
    <Color x:Key="ColorBlackAlpha60">#99000000</Color>

    <!-- Greens -->
    <Color x:Key="ColorGreen500">#5A6F61</Color>
    <Color x:Key="ColorGreen700">#3C5F46</Color>
    <Color x:Key="ColorGreen800">#2B4933</Color>
    <Color x:Key="ColorGreen800Alpha16">#292B4933</Color>
    <Color x:Key="ColorGreen800Alpha35">#592B4933</Color>
    <Color x:Key="ColorGreen900">#1B3021</Color>
    <Color x:Key="ColorGreenAlpha12">#20008000</Color>
    <Color x:Key="ColorForestGreen">#228B22</Color>

    <!-- Reds -->
    <Color x:Key="ColorRed400">#D44D4D</Color>
    <Color x:Key="ColorRed500">#B13434</Color>
    <Color x:Key="ColorRed600">#9E2A2A</Color>
    <Color x:Key="ColorRed700">#B52828</Color>
    <Color x:Key="ColorRed800">#7A1F1F</Color>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataGrid Row Brushes -->
    <SolidColorBrush x:Key="DataGridRowWhiteBrush" Color="{StaticResource ColorDataGridRowWhite}"/>
    <SolidColorBrush x:Key="DataGridRowGrayBrush" Color="{StaticResource ColorDataGridRowGray}"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="{StaticResource ColorDataGridGridLine}"/>

    <!-- Role-based utility brushes. These are intentionally independent from component styles. -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorBrown800}"/>
    <SolidColorBrush x:Key="BrushTextStrong" Color="{StaticResource ColorBrown900}"/>
    <SolidColorBrush x:Key="BrushTextOnDark" Color="{StaticResource ColorWhite}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorBrown800}"/>
    <SolidColorBrush x:Key="BrushTextSuccess" Color="{StaticResource ColorGreen900}"/>
    <SolidColorBrush x:Key="BrushTextError" Color="{StaticResource ColorRed800}"/>
    <SolidColorBrush x:Key="BrushTextWarning" Color="{StaticResource ColorOrange500}"/>
    <SolidColorBrush x:Key="BrushTextBlack" Color="{StaticResource ColorBlack}"/>
    <SolidColorBrush x:Key="BrushTextBrown950" Color="{StaticResource ColorBrown950}"/>
    <SolidColorBrush x:Key="BrushTextCode" Color="{StaticResource ColorBlue700}"/>
    <SolidColorBrush x:Key="BrushTextHighlight" Color="{StaticResource ColorAmber300}"/>
    <SolidColorBrush x:Key="BrushTextSuccessHover" Color="{StaticResource ColorGreen700}"/>
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBrown200}"/>
    <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorBrown400}"/>
    <SolidColorBrush x:Key="BrushBgAction" Color="{StaticResource ColorBrown800}"/>
    <SolidColorBrush x:Key="BrushBgActionHover" Color="{StaticResource ColorBrown400}"/>
    <SolidColorBrush x:Key="BrushBgActionStrong" Color="{StaticResource ColorBrown900}"/>
    <SolidColorBrush x:Key="BrushBgAccent" Color="{StaticResource ColorBrown600}"/>
    <SolidColorBrush x:Key="BrushBgSuccess" Color="{StaticResource ColorGreen800}"/>
    <SolidColorBrush x:Key="BrushBgSuccessHover" Color="{StaticResource ColorGreen700}"/>
    <SolidColorBrush x:Key="BrushBgDanger" Color="{StaticResource ColorRed600}"/>
    <SolidColorBrush x:Key="BrushBgDangerLight" Color="{StaticResource ColorRed400}"/>
    <SolidColorBrush x:Key="BrushBgDangerHover" Color="{StaticResource ColorRed500}"/>
    <SolidColorBrush x:Key="BrushBgHighlight" Color="{StaticResource ColorAmber300}"/>
    <SolidColorBrush x:Key="BrushBgDisabled" Color="{StaticResource ColorGray500}"/>
    <SolidColorBrush x:Key="BrushBgSelected" Color="#FFE8D8B0"/>
    <SolidColorBrush x:Key="BrushStatePrimary" Color="{StaticResource ColorBrown800}"/>
    <SolidColorBrush x:Key="BrushStateSuccess" Color="{StaticResource ColorGreen800}"/>
    <SolidColorBrush x:Key="BrushStateDanger" Color="{StaticResource ColorRed600}"/>
    <SolidColorBrush x:Key="BrushStateDangerStrong" Color="{StaticResource ColorRed700}"/>
    <SolidColorBrush x:Key="BrushStateHighlight" Color="{StaticResource ColorAmber300}"/>
    <SolidColorBrush x:Key="BrushStateWarning" Color="{StaticResource ColorOrange600}"/>
    <SolidColorBrush x:Key="BrushStateNeutral" Color="{StaticResource ColorGray500}"/>
    <SolidColorBrush x:Key="BrushStatePanel" Color="{StaticResource ColorBrown400}"/>

    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBrown800}"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBrown900}"/>
    <SolidColorBrush x:Key="BrushBorderMuted" Color="{StaticResource ColorBrown600}"/>
    <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorAmber300}"/>
    <SolidColorBrush x:Key="BrushBorderSuccess" Color="{StaticResource ColorGreen900}"/>
    <SolidColorBrush x:Key="BrushBorderError" Color="{StaticResource ColorRed800}"/>
</ResourceDictionary>

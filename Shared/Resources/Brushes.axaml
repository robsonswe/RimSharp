<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataGrid Row Brushes -->
    <SolidColorBrush x:Key="DataGridRowWhiteBrush" Color="{StaticResource ColorDataGridRowWhite}"/>
    <SolidColorBrush x:Key="DataGridRowGrayBrush" Color="{StaticResource ColorDataGridRowGray}"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="{StaticResource ColorDataGridGridLine}"/>

    <!-- Role-based utility brushes. These are intentionally independent from component styles. -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorBrown}"/>
    <SolidColorBrush x:Key="BrushTextStrong" Color="{StaticResource ColorDarkBrown}"/>
    <SolidColorBrush x:Key="BrushTextOnDark" Color="{StaticResource ColorWhite}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorLightBrown}"/>
    <SolidColorBrush x:Key="BrushTextSuccess" Color="{StaticResource ColorDarkGreen}"/>
    <SolidColorBrush x:Key="BrushTextError" Color="{StaticResource ColorErrorRed}"/>
    <SolidColorBrush x:Key="BrushTextWarning" Color="{StaticResource ColorOrange}"/>
    <SolidColorBrush x:Key="BrushTextBlack" Color="{StaticResource ColorBlack}"/>
    <SolidColorBrush x:Key="BrushTextCode" Color="{StaticResource ColorCodeBlue}"/>
    <SolidColorBrush x:Key="BrushTextHighlight" Color="{StaticResource ColorHighlight}"/>
    <SolidColorBrush x:Key="BrushTextSuccessHover" Color="{StaticResource ColorDarkGreenHover}"/>
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBeige}"/>
    <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorDarkBeige}"/>
    <SolidColorBrush x:Key="BrushBgAction" Color="{StaticResource ColorBrown}"/>
    <SolidColorBrush x:Key="BrushBgActionHover" Color="{StaticResource ColorDarkBeige}"/>
    <SolidColorBrush x:Key="BrushBgActionStrong" Color="{StaticResource ColorDarkBrown}"/>
    <SolidColorBrush x:Key="BrushBgAccent" Color="{StaticResource ColorLightBrown}"/>
    <SolidColorBrush x:Key="BrushBgSuccess" Color="{StaticResource ColorDarkGreen}"/>
    <SolidColorBrush x:Key="BrushBgSuccessHover" Color="{StaticResource ColorDarkGreenHover}"/>
    <SolidColorBrush x:Key="BrushBgDanger" Color="{StaticResource ColorRed}"/>
    <SolidColorBrush x:Key="BrushBgDangerLight" Color="{StaticResource ColorRedLight}"/>
    <SolidColorBrush x:Key="BrushBgDangerHover" Color="{StaticResource ColorRedHover}"/>
    <SolidColorBrush x:Key="BrushBgHighlight" Color="{StaticResource ColorHighlight}"/>
    <SolidColorBrush x:Key="BrushBgDisabled" Color="{StaticResource ColorGray}"/>
    <SolidColorBrush x:Key="BrushBgSelected" Color="#FFE8D8B0"/>
    <SolidColorBrush x:Key="BrushStatePrimary" Color="{StaticResource ColorBrown}"/>
    <SolidColorBrush x:Key="BrushStateSuccess" Color="{StaticResource ColorDarkGreen}"/>
    <SolidColorBrush x:Key="BrushStateDanger" Color="{StaticResource ColorRed}"/>
    <SolidColorBrush x:Key="BrushStateDangerStrong" Color="{StaticResource ColorErrorRed}"/>
    <SolidColorBrush x:Key="BrushStateHighlight" Color="{StaticResource ColorHighlight}"/>
    <SolidColorBrush x:Key="BrushStateWarning" Color="{StaticResource ColorConfigOrange}"/>
    <SolidColorBrush x:Key="BrushStateNeutral" Color="{StaticResource ColorGray}"/>
    <SolidColorBrush x:Key="BrushStatePanel" Color="{StaticResource ColorDarkBeige}"/>

    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBrown}"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorDarkBrown}"/>
    <SolidColorBrush x:Key="BrushBorderMuted" Color="{StaticResource ColorLightBrown}"/>
    <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorHighlight}"/>
    <SolidColorBrush x:Key="BrushBorderSuccess" Color="{StaticResource ColorDarkGreenBorder}"/>
    <SolidColorBrush x:Key="BrushBorderError" Color="{StaticResource ColorRedBorder}"/>
</ResourceDictionary>

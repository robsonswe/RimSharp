<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RimSharp.Core.Helpers">

    <!-- Panel border -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style Selector="Border.panel-subtle">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/> <!-- Adjusted to existing brush -->
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <!-- Global TextBox Selection Styles -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <!-- Keep context menus on the app palette instead of the platform default. -->
    <Style Selector="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource RimSharpFontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource RimSharpFontFamily}"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>

    <!-- Text input -->
    <Style Selector="TextBox.input">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                    <ScrollViewer x:Name="PART_ScrollViewer"
                                  Background="Transparent"
                                  Focusable="false"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Padding="{TemplateBinding Padding}">
                        <TextPresenter x:Name="PART_TextPresenter"
                                       Text="{TemplateBinding Text}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="{TemplateBinding CaretBrush}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="{TemplateBinding TextWrapping}"
                                       IsHitTestVisible="True"/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Watermark text input -->
    <Style Selector="TextBox.input-watermark">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                    <Grid>
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}">
                            <TextPresenter x:Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           IsHitTestVisible="True"/>
                        </ScrollViewer>
                        <TextBlock x:Name="PART_Watermark"
                                   Text="{TemplateBinding Watermark}"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   IsHitTestVisible="False"
                                   Margin="6,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <TextBlock.IsVisible>
                                <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" Converter="{StaticResource StringIsNullOrEmptyConverter}"/>
                            </TextBlock.IsVisible>
                        </TextBlock>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Check box -->
    <Style Selector="CheckBox.checkbox, CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>

        <!-- Template-specific overrides to force the border color (NormalRectangle in Fluent theme) -->
        <Style Selector="^ /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        </Style>

        <!-- Checked state often uses a different border/background element in some templates -->
        <Style Selector="^ /template/ Border#CheckBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#CheckBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#CheckBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        </Style>

        <!-- Explicitly handle :checked with higher specificity to beat Fluent defaults -->
        <Style Selector="^:checked:pointerover /template/ Border#CheckBackground">
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="^:checked:pressed /template/ Border#CheckBackground">
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="^:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>

        <Style.Resources>
            <!-- Border / Stroke - Unchecked -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="{StaticResource ColorGray500}" />

            <!-- Background / Fill - Unchecked -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource ColorBrown200}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource ColorBrown400}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource ColorBrown400}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" Color="{StaticResource ColorGray500}" />

            <!-- Border / Stroke - Checked -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="{StaticResource ColorGray500}" />

            <!-- Background / Fill - Checked -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="{StaticResource ColorGray500}" />

            <!-- Foreground - Ensure ALWAYS brown -->
            <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="{StaticResource ColorGray500}" />
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="{StaticResource ColorGray500}" />

            <!-- Glyph (Checkmark) -->
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource ColorWhite}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource ColorWhite}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource ColorWhite}" />
        </Style.Resources>
    </Style>

    <!-- Radio button -->
    <Style Selector="RadioButton.radio, RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>

        <!-- Template-specific overrides for RadioButton - Forced for all states -->
        <Style Selector="^ /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgSurface}"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>

        <!-- Explicitly handle unchecked to beat Fluent theme defaults -->
        <Style Selector="^:unchecked /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgSurface}"/>
        </Style>

        <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgActionStrong}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgPanel}"/>
        </Style>

        <Style Selector="^:pressed /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgActionStrong}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgPanel}"/>
        </Style>

        <!-- Checked states -->
        <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgAction}"/>
        </Style>

        <Style Selector="^:checked:pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgActionStrong}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgActionStrong}"/>
        </Style>

        <Style Selector="^ /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgAction}"/>
        </Style>

        <Style Selector="^ /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource BrushTextOnDark}"/>
        </Style>

        <Style.Resources>
            <!-- Normal State (Unchecked) -->
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillUnchecked" Color="{StaticResource ColorBrown200}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeUnchecked" Color="{StaticResource ColorBrown800}" />

            <!-- PointerOver State (Unchecked) -->
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillUncheckedPointerOver" Color="{StaticResource ColorBrown400}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeUncheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="RadioButtonForegroundUncheckedPointerOver" Color="{StaticResource ColorBrown800}" />

            <!-- Pressed State (Unchecked) -->
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillUncheckedPressed" Color="{StaticResource ColorBrown400}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeUncheckedPressed" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="RadioButtonForegroundUncheckedPressed" Color="{StaticResource ColorBrown800}" />

            <!-- Checked State -->
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillCheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeCheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="RadioButtonForegroundChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="RadioButtonForegroundCheckedPointerOver" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="RadioButtonForegroundCheckedPressed" Color="{StaticResource ColorBrown800}" />

            <!-- Glyph (Dot) -->
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillChecked" Color="{StaticResource ColorWhite}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillCheckedPointerOver" Color="{StaticResource ColorWhite}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillCheckedPressed" Color="{StaticResource ColorWhite}" />
        </Style.Resources>
    </Style>

    <!-- Tab item toggles -->
    <Style Selector="TabControl.tabs TabItem">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextBrown950}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.tabs TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>
    <Style Selector="TabControl.tabs TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
    </Style>
    <Style Selector="TabControl.tabs TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>

    <!-- List box -->
    <Style Selector="ListBox.list">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                    <ScrollViewer Focusable="False"
                                  Padding="{TemplateBinding Padding}"
                                  AllowAutoHide="False">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Global ScrollViewer Style to prevent auto-hide and overlay -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <!-- Force ScrollBars to take space instead of overlaying -->
    <Style Selector="ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
        <Setter Property="Grid.ColumnSpan" Value="1"/>
        <Setter Property="Grid.RowSpan" Value="1"/>
    </Style>

    <!-- List box item -->
    <Style Selector="ListBox.list > ListBoxItem">
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Bd"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
        </Style>
    </Style>

    <!-- Safe list box (doesn't override the control template) -->
    <Style Selector="ListBox.list-safe">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="ListBox.list-safe ListBoxItem">
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="ListBox.list-safe ListBoxItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>
    <Style Selector="ListBox.list-safe ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
    </Style>
    <Style Selector="ListBox.list-safe ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>

    <!-- List header border -->
    <Style Selector="Border.list-header">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="7,5"/>
    </Style>

    <!-- Info header border -->
    <Style Selector="Border.info-header">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- Progress Bar -->
    <Style Selector="ProgressBar.progress">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSuccess}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="IsIndeterminate" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="ProgressBarRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2"
                        ClipToBounds="True">
                    <Grid x:Name="PART_InternalGrid">
                        <!-- Determinate Indicator -->
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding !IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!-- Indeterminate state handling -->
                        <Border x:Name="IndeterminateIndicator"
                                Background="{TemplateBinding Foreground}"
                                Width="150"
                                HorizontalAlignment="Left"
                                IsVisible="{TemplateBinding IsIndeterminate}">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ProgressBar.progress[IsIndeterminate=True] /template/ Border#IndeterminateIndicator">
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="Infinite">
                <KeyFrame KeyTime="0:0:0">
                    <Setter Property="TranslateTransform.X" Value="-150"/>
                </KeyFrame>
                <KeyFrame KeyTime="0:0:1.5">
                    <Setter Property="TranslateTransform.X" Value="600"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Separator -->
    <Style Selector="Separator.separator">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
    </Style>

</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RimSharp.Core.Helpers"
        xmlns:i="https://github.com/projektanker/icons.avalonia">

    <!-- Panel border -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <Style Selector="Border.panel-subtle">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <!-- Global TextBox Selection Styles -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>

    <!-- Keep context menus on the app palette instead of the platform default. -->
    <Style Selector="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource RimSharpFontFamily}"/>
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource RimSharpFontFamily}"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style Selector="ContextMenu > MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>

    <!-- Text input -->
    <Style Selector="TextBox.input">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                    <Grid>
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      Background="Transparent"
                                      Focusable="false"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}">
                            <TextPresenter x:Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           IsHitTestVisible="True"/>
                        </ScrollViewer>
                        <TextBlock x:Name="PART_Watermark"
                                   Text="{TemplateBinding PlaceholderText}"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   Opacity="0.55"
                                   IsHitTestVisible="False"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <TextBlock.IsVisible>
                                <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" Converter="{StaticResource StringIsNullOrEmptyConverter}"/>
                            </TextBlock.IsVisible>
                        </TextBlock>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TextBox.input:focus">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurfaceFocus}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushTextBrown950}"/>
    </Style>

    <!-- Watermark text input -->
    <Style Selector="TextBox.input-watermark">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                    <Grid>
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}">
                            <TextPresenter x:Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           IsHitTestVisible="True"/>
                        </ScrollViewer>
                        <TextBlock x:Name="PART_Watermark"
                                   Text="{TemplateBinding Watermark}"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   IsHitTestVisible="False"
                                   Margin="6,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <TextBlock.IsVisible>
                                <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" Converter="{StaticResource StringIsNullOrEmptyConverter}"/>
                            </TextBlock.IsVisible>
                        </TextBlock>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Check box -->
    <Style Selector="CheckBox.checkbox, CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>

        <Style Selector="^ /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        </Style>

        <Style Selector="^ /template/ Border#CheckBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#CheckBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#CheckBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#CheckBackground">
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="^:checked:pressed /template/ Border#CheckBackground">
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>
        <Style Selector="^:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        </Style>

        <Style.Resources>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="{StaticResource ColorGray500}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource ColorBrown200}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource ColorBrown400}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource ColorBrown400}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" Color="{StaticResource ColorGray500}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="{StaticResource ColorGray500}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="{StaticResource ColorGray500}" />

            <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedPressed" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="{StaticResource ColorGray500}" />
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="{StaticResource ColorGray500}" />

            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource ColorWhite}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource ColorWhite}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource ColorWhite}" />
        </Style.Resources>
    </Style>

    <!-- Radio button -->
    <Style Selector="RadioButton.radio, RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>

        <Style Selector="^ /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgSurface}"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>

        <Style Selector="^:unchecked /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgSurface}"/>
        </Style>

        <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgActionStrong}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgPanel}"/>
        </Style>

        <Style Selector="^:pressed /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgActionStrong}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgPanel}"/>
        </Style>

        <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgAction}"/>
        </Style>

        <Style Selector="^:checked:pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgActionStrong}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgActionStrong}"/>
        </Style>

        <Style Selector="^ /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource BrushBgAction}"/>
            <Setter Property="Fill" Value="{DynamicResource BrushBgAction}"/>
        </Style>

        <Style Selector="^ /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource BrushTextOnDark}"/>
        </Style>

        <Style.Resources>
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillUnchecked" Color="{StaticResource ColorBrown200}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeUnchecked" Color="{StaticResource ColorBrown800}" />

            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillUncheckedPointerOver" Color="{StaticResource ColorBrown400}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeUncheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="RadioButtonForegroundUncheckedPointerOver" Color="{StaticResource ColorBrown800}" />

            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillUncheckedPressed" Color="{StaticResource ColorBrown400}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeUncheckedPressed" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="RadioButtonForegroundUncheckedPressed" Color="{StaticResource ColorBrown800}" />

            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillCheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeCheckedPointerOver" Color="{StaticResource ColorBrown900}" />
            <SolidColorBrush x:Key="RadioButtonForegroundChecked" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="RadioButtonForegroundCheckedPointerOver" Color="{StaticResource ColorBrown800}" />
            <SolidColorBrush x:Key="RadioButtonForegroundCheckedPressed" Color="{StaticResource ColorBrown800}" />

            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillChecked" Color="{StaticResource ColorWhite}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillCheckedPointerOver" Color="{StaticResource ColorWhite}" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFillCheckedPressed" Color="{StaticResource ColorWhite}" />
        </Style.Resources>
    </Style>

    <!-- Tab item toggles (existing horizontal tabs — kept intact for main views) -->
    <Style Selector="TabControl.tabs TabItem">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,5,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_LayoutRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource BrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabControl.tabs TabItem /template/ ContentPresenter TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>

    <Style Selector="TabControl.tabs TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>
    <Style Selector="TabControl.tabs TabItem:pointerover /template/ ContentPresenter TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>

    <Style Selector="TabControl.tabs TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>
    <Style Selector="TabControl.tabs TabItem:selected /template/ ContentPresenter TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>

    <!-- List box -->
    <Style Selector="ListBox.list">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                    <ScrollViewer Focusable="False"
                                  Padding="{TemplateBinding Padding}"
                                  AllowAutoHide="False">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <Style Selector="ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
        <Setter Property="Grid.ColumnSpan" Value="1"/>
        <Setter Property="Grid.RowSpan" Value="1"/>
    </Style>

    <Style Selector="ListBox.list > ListBoxItem">
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Bd"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
        </Style>
    </Style>

    <!-- Safe list box -->
    <Style Selector="ListBox.list-safe">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="ListBox.list-safe ListBoxItem">
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="ListBox.list-safe ListBoxItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    </Style>
    <Style Selector="ListBox.list-safe ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
    </Style>
    <Style Selector="ListBox.list-safe ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    </Style>

    <!-- Warm Picker ListBox (Select Mod) -->
    <Style Selector="ListBox.list-picker">
        <Setter Property="Background" Value="{DynamicResource BrushBgPickerList}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <ScrollViewer Focusable="False"
                                  Padding="{TemplateBinding Padding}"
                                  AllowAutoHide="False">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.list-picker > ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="RowBg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Border x:Name="RowAccent"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            Padding="10,7,14,7">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.list-picker > ListBoxItem:pointerover /template/ Border#RowBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
    </Style>
    <Style Selector="ListBox.list-picker > ListBoxItem:selected /template/ Border#RowBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
    </Style>
    <Style Selector="ListBox.list-picker > ListBoxItem:selected /template/ Border#RowAccent">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBgAction}"/>
    </Style>
    <Style Selector="ListBox.list-picker > ListBoxItem:selected:pointerover /template/ Border#RowBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
    </Style>

    <!-- List header border -->
    <Style Selector="Border.list-header">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="7,5"/>
    </Style>

    <!-- Info header border -->
    <Style Selector="Border.info-header">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- Progress Bar -->
    <Style Selector="ProgressBar.progress">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSuccess}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="IsIndeterminate" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="ProgressBarRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2"
                        ClipToBounds="True">
                    <Grid x:Name="PART_InternalGrid">
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding !IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <Border x:Name="IndeterminateIndicator"
                                Background="{TemplateBinding Foreground}"
                                Width="150"
                                HorizontalAlignment="Left"
                                IsVisible="{TemplateBinding IsIndeterminate}">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ProgressBar.progress[IsIndeterminate=True] /template/ Border#IndeterminateIndicator">
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="Infinite">
                <KeyFrame KeyTime="0:0:0">
                    <Setter Property="TranslateTransform.X" Value="-150"/>
                </KeyFrame>
                <KeyFrame KeyTime="0:0:1.5">
                    <Setter Property="TranslateTransform.X" Value="600"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ComboBoxItem disabled state -->
    <Style Selector="ComboBoxItem:disabled">
        <Setter Property="Opacity" Value="0.4"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushBgDisabled}"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    <Style Selector="ComboBoxItem:disabled TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushBgDisabled}"/>
    </Style>
    <Style Selector="ComboBoxItem:disabled:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Separator -->
    <Style Selector="Separator.separator">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,5,0,5"/>
    </Style>

    <!-- ================================================================
    SHARED REDESIGN SYSTEM (Sidebar Rail, Select, Cards, Footers)
    ================================================================ -->

    <!-- Typography helpers -->
    <Style Selector="TextBlock.pane-title">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextBrown950}"/>
    </Style>
    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>
    <Style Selector="TextBlock.field-hint">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.mono-sub">
        <Setter Property="FontFamily" Value="{DynamicResource RimSharpMonoFontFamily}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <!-- Strikethrough helper for overridden / disabled rules -->
    <Style Selector="TextBlock.strike">
        <Setter Property="TextDecorations" Value="Strikethrough"/>
        <Setter Property="Opacity" Value="0.78"/>
    </Style>

    <!-- Password input with built-in RevealPassword eye toggle -->
    <Style Selector="TextBox.input-password">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushBgAccent}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BrushTextOnDark}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,0,4,0"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid Grid.Column="0">
                            <ScrollViewer x:Name="PART_ScrollViewer"
                                          Background="Transparent"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}">
                                <TextPresenter x:Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text}"
                                               PasswordChar="{TemplateBinding PasswordChar}"
                                               RevealPassword="{TemplateBinding RevealPassword}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               IsHitTestVisible="True"/>
                            </ScrollViewer>
                            <TextBlock x:Name="PART_Watermark"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Opacity="0.55"
                                       IsHitTestVisible="False"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <TextBlock.IsVisible>
                                    <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" Converter="{StaticResource StringIsNullOrEmptyConverter}"/>
                                </TextBlock.IsVisible>
                            </TextBlock>
                        </Grid>

                        <ToggleButton x:Name="PART_RevealButton"
                                      Grid.Column="1"
                                      Width="26" Height="26" Margin="0,0,3,0"
                                      Focusable="False"
                                      IsChecked="{Binding RevealPassword, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ToolTip.Tip="Show / Hide">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="EyeBg" Background="Transparent" CornerRadius="2">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:pointerover /template/ Border#EyeBg">
                                    <Setter Property="Background" Value="{DynamicResource BrushBgBadgeMuted}"/>
                                </Style>
                            </ToggleButton.Styles>
                            <Panel>
                                <i:Icon Value="fa-eye" FontSize="12"
                                        Foreground="{DynamicResource BrushTextPrimary}"
                                        IsVisible="{Binding !#PART_RevealButton.IsChecked}"/>
                                <i:Icon Value="fa-eye-slash" FontSize="12"
                                        Foreground="{DynamicResource BrushTextPrimary}"
                                        IsVisible="{Binding #PART_RevealButton.IsChecked}"/>
                            </Panel>
                        </ToggleButton>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBox.input-password:focus">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurfaceFocus}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushTextBrown950}"/>
    </Style>

    <!-- Styled ComboBox.select -->
    <Style Selector="ComboBox.select">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextBrown950}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="9,5"/>
        <Style.Resources>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource ColorBrown200}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource ColorBrown150}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource ColorBrown150}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource ColorBrown800}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource ColorBrown900}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource ColorBrown950}"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ColorBrown950}"/>
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource ColorBrown950}"/>
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="{StaticResource ColorBrown950}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource ColorBrown900}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource ColorBrown200}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource ColorBrown800}"/>
        </Style.Resources>
    </Style>
    <Style Selector="ComboBox.select /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="ComboBox.select:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="ComboBox.select ComboBoxItem:not(:disabled)">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextBrown950}"/>
    </Style>

    <!-- Left Sidebar Rail TabControl (separate from TabControl.tabs; text-only links) -->
    <Style Selector="TabControl.tabs-rail">
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" Spacing="3"/>
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="188,*">
                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushBgSidebar}"
                            BorderBrush="{DynamicResource BrushBorderDefault}"
                            BorderThickness="0,0,1,0"
                            Padding="8,10">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </Border>
                    <ScrollViewer Grid.Column="1"
                                  Background="{DynamicResource BrushBgSurface}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          Margin="20,16"/>
                    </ScrollViewer>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabControl.tabs-rail TabItem">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <!-- Optional group header passed via TabItem.Tag (e.g. GENERAL, DATABASES) -->
                    <TextBlock x:Name="PART_GroupLabel"
                               Text="{TemplateBinding Tag}"
                               IsVisible="{TemplateBinding Tag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               IsHitTestVisible="False"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextStrong}"
                               Opacity="0.72"
                               Margin="10,10,10,4"/>
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Border Name="PART_AccentBar"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="2">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Scope text color ONLY to PART_ContentPresenter so TabItem.Content is never painted white -->
    <Style Selector="TabControl.tabs-rail TabItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextBrown950}"/>
    </Style>
    <Style Selector="TabControl.tabs-rail TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource BrushBgSidebarItemHover}"/>
    </Style>
    <Style Selector="TabControl.tabs-rail TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextBrown950}"/>
    </Style>
    <Style Selector="TabControl.tabs-rail TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="TabControl.tabs-rail TabItem:selected /template/ Border#PART_AccentBar">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushStateHighlight}"/>
    </Style>
    <Style Selector="TabControl.tabs-rail TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>
    <Style Selector="TabControl.tabs-rail TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="TabControl.tabs-rail TabItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>

    <!-- Containers, cards, callouts, badges, footer -->
    <Style Selector="Border.surface-box">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="14,11"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="11,9"/>
    </Style>
    <Style Selector="Border.card.disabled">
        <Setter Property="Background" Value="{DynamicResource BrushBgCardDisabled}"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <Style Selector="Border.callout-warning">
        <Setter Property="Background" Value="{DynamicResource BrushBgCallout}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="3,1,1,1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style Selector="Border.pill-badge">
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.pill-badge.muted">
        <Setter Property="Background" Value="{DynamicResource BrushBgBadgeMuted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderBadgeMuted}"/>
    </Style>
    <Style Selector="Border.pill-badge.success">
        <Setter Property="Background" Value="{DynamicResource BrushBgBadgeSuccess}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderBadgeSuccess}"/>
    </Style>
    <Style Selector="Border.pill-badge.mod">
        <Setter Property="Background" Value="{DynamicResource BrushBgBadgeMod}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderBadgeMod}"/>
    </Style>

    <Style Selector="Border.stepper">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.dialog-footer">
        <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- ================================================================
    SEGMENTED TRI-STATE PILLS & SELECTABLE CARDS
    ================================================================ -->

    <!-- Container for 3-way segmented radio pills -->
    <Style Selector="Border.tri-seg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Individual option inside Border.tri-seg (use tri-any / tri-yes / tri-no) -->
    <Style Selector="RadioButton.tri-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinWidth" Value="50"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="SegBg"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tri-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>
    <Style Selector="RadioButton.tri-btn:pointerover /template/ Border#SegBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
    </Style>
    <Style Selector="RadioButton.tri-btn.tri-any:checked /template/ Border#SegBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgAccent}"/>
    </Style>
    <Style Selector="RadioButton.tri-btn.tri-any:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>
    <Style Selector="RadioButton.tri-btn.tri-yes:checked /template/ Border#SegBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSuccess}"/>
    </Style>
    <Style Selector="RadioButton.tri-btn.tri-yes:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>
    <Style Selector="RadioButton.tri-btn.tri-no:checked /template/ Border#SegBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgDanger}"/>
    </Style>
    <Style Selector="RadioButton.tri-btn.tri-no:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>

    <!-- Neutral active segmented option (dark brown fill + white text) -->
    <Style Selector="RadioButton.tri-btn.tri-neutral:checked /template/ Border#SegBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
    </Style>
    <Style Selector="RadioButton.tri-btn.tri-neutral:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>

    <!-- Selectable card checkbox (e.g. Mod Types grid) -->
    <Style Selector="CheckBox.check-card">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextBrown950}"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="CardRoot"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        ClipToBounds="True">
                    <Border x:Name="CardAccent"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <Border x:Name="CheckSquare"
                                    Grid.Column="0"
                                    Width="15" Height="15"
                                    Background="{DynamicResource BrushBgSurface}"
                                    BorderBrush="{DynamicResource BrushBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <i:Icon x:Name="CheckGlyph"
                                        Value="fa-check"
                                        FontSize="9"
                                        Foreground="{DynamicResource BrushTextOnDark}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="False"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.check-card:pointerover /template/ Border#CardRoot">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
    </Style>
    <Style Selector="CheckBox.check-card:checked /template/ Border#CardRoot">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="CheckBox.check-card:checked /template/ Border#CardAccent">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBgAction}"/>
    </Style>
    <Style Selector="CheckBox.check-card:checked /template/ Border#CheckSquare">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="CheckBox.check-card:checked /template/ i|Icon#CheckGlyph">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- ================================================================
         CUSTOMIZE MOD: RULE CARDS, ALERTS, SEGMENTED PICKERS & FAV TOGGLE
         ================================================================ -->

    <!-- Alert boxes (.warning, .danger, .info) -->
    <Style Selector="Border.alert-box">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="3,1,1,1"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="Border.alert-box.warning">
        <Setter Property="Background" Value="{DynamicResource BrushBgCallout}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
    </Style>
    <Style Selector="Border.alert-box.danger">
        <Setter Property="Background" Value="{DynamicResource BrushBgDangerWash}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderError}"/>
    </Style>
    <Style Selector="Border.alert-box.info">
        <Setter Property="Background" Value="{DynamicResource BrushBgInfoWash}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInfo}"/>
    </Style>

    <!-- Rule cards (.inherited, .overridden, .disabled) — outer 1px border; inner border handles 3px accent -->
    <Style Selector="Border.rule-card">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.rule-card.inherited">
        <Setter Property="Background" Value="{DynamicResource BrushBgCardDisabled}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
    </Style>
    <Style Selector="Border.rule-card.overridden">
        <Setter Property="Background" Value="{DynamicResource BrushBgOverridden}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
        <Setter Property="Opacity" Value="0.74"/>
    </Style>
    <Style Selector="Border.rule-card.disabled">
        <Setter Property="Background" Value="{DynamicResource BrushBgCardDisabled}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
        <Setter Property="Opacity" Value="0.56"/>
    </Style>

    <!-- Additional pill-badge variants -->
    <Style Selector="Border.pill-badge.db">
        <Setter Property="Background" Value="{DynamicResource BrushBgBadgeMod}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderBadgeMod}"/>
    </Style>
    <Style Selector="Border.pill-badge.custom">
        <Setter Property="Background" Value="{DynamicResource BrushBgBadgeSuccess}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderBadgeSuccess}"/>
    </Style>
    <Style Selector="Border.pill-badge.hard">
        <Setter Property="Background" Value="{DynamicResource BrushBgDangerWash}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderError}"/>
    </Style>
    <Style Selector="Border.pill-badge.soft">
        <Setter Property="Background" Value="{DynamicResource BrushBgSoftBadge}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderBadgeMuted}"/>
    </Style>
    <Style Selector="Border.pill-badge.overridden">
        <Setter Property="Background" Value="{DynamicResource BrushBgCallout}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
    </Style>

    <!-- Favorite ToggleButton (explicit logical TextBlock + star foreground) -->
    <Style Selector="ToggleButton.fav-toggle">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="FavBg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- The Fluent theme paints a background on the templated ContentPresenter across
         toggle states; keep it clear so only FavBg supplies the checked surface. -->
    <Style Selector="ToggleButton.fav-toggle /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.fav-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.fav-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.fav-toggle:checked /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.fav-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>
    <Style Selector="ToggleButton.fav-toggle TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>
    <Style Selector="ToggleButton.fav-toggle i|Icon">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>
    <Style Selector="ToggleButton.fav-toggle:pointerover /template/ Border#FavBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
    </Style>
    <Style Selector="ToggleButton.fav-toggle:checked /template/ Border#FavBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSuccess}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSuccess}"/>
    </Style>
    <Style Selector="ToggleButton.fav-toggle:checked TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>
    <Style Selector="ToggleButton.fav-toggle:checked i|Icon">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextHighlight}"/>
    </Style>

    <!-- Filter Pill RadioButton -->
    <Style Selector="RadioButton.f-pill">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PillBg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.f-pill /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextStrong}"/>
    </Style>
    <Style Selector="RadioButton.f-pill:pointerover /template/ Border#PillBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
    </Style>
    <Style Selector="RadioButton.f-pill:checked /template/ Border#PillBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="RadioButton.f-pill:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>

    <!-- 4-way Relation Type Card RadioButton (Rule Editor) -->
    <Style Selector="RadioButton.rel-card">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="RelBg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.rel-card /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextBrown950}"/>
    </Style>
    <Style Selector="RadioButton.rel-card:pointerover /template/ Border#RelBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgSelected}"/>
    </Style>
    <Style Selector="RadioButton.rel-card:checked /template/ Border#RelBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    </Style>
    <Style Selector="RadioButton.rel-card.rel-hard:checked /template/ Border#RelBg">
        <Setter Property="Background" Value="{DynamicResource BrushBgDanger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderError}"/>
    </Style>
    <Style Selector="RadioButton.rel-card:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushTextOnDark}"/>
    </Style>
    <Style Selector="RadioButton.rel-card:disabled">
        <Setter Property="Opacity" Value="0.42"/>
    </Style>

</Styles>
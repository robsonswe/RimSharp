<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
        xmlns:local="clr-namespace:RimSharp.AppDir.Dialogs"
        xmlns:models="clr-namespace:RimSharp.Shared.Models"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="RimSharp.AppDir.Dialogs.SettingsDialogView"
        mc:Ignorable="d"
        x:DataType="local:SettingsDialogViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        SizeToContent="Height"
        Width="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.MainContent>
        <Border Classes="panel">
            <TabControl Classes="tabs" Margin="12">

                <!-- TAB 1: GAME -->
                <TabItem Header="Game">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="18">

                            <!-- Distribution Selection -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Game Distribution" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextStrong}"/>

                                <ComboBox SelectedValue="{Binding SelectedDistribution, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                          Width="220"
                                          VerticalAlignment="Center"
                                          Classes="select">
                                    <ComboBoxItem Tag="{x:Static models:GameDistribution.NonSteam}" Content="Non-Steam"/>
                                    <ComboBoxItem Tag="{x:Static models:GameDistribution.Steam}"
                                                Content="Steam"
                                                IsEnabled="{Binding SteamAvailable, Mode=OneWay}"
                                                ToolTip.Tip="No Steam installation of RimWorld detected"
                                                ToolTip.ShowOnDisabled="True"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Game Directory -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Game Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseGamePathCommand}"
                                            Classes="btn" Padding="10,4"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenGameFolderCommand}"
                                            Classes="btn" Padding="10,4"/>
                                </Grid>
                                <TextBox Text="{Binding GamePath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Folder where RimWorld is installed"/>
                            </StackPanel>

                            <!-- Config Directory -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Config Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseConfigPathCommand}"
                                            Classes="btn" Padding="10,4"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenConfigFolderCommand}"
                                            Classes="btn" Padding="10,4"/>
                                </Grid>
                                <TextBox Text="{Binding ConfigPath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Folder with RimWorld's config files"/>
                            </StackPanel>

                            <!-- Mods Directory Override -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Mods Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseModsFolderCommand}"
                                            Classes="btn" Padding="10,4"
                                            IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenModsFolderCommand}"
                                            Classes="btn" Padding="10,4"
                                            IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                                </Grid>
                                <TextBox Text="{Binding ModsFolderPath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Set the game path first; defaults to game\Mods"
                                         IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource BrushTextStrong}"
                                       Text="Mod and config folders resolve from these directories. Restart is not required, but already-loaded lists keep the previous paths."/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 2: UPDATES -->
                <TabItem Header="Updates">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="18">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Update Channel" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding UpdateChannel, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                              Width="140"
                                              VerticalAlignment="Center"
                                              Classes="select">
                                        <ComboBoxItem Tag="stable" Content="Stable"/>
                                        <ComboBoxItem Tag="beta" Content="Beta"/>
                                        <ComboBoxItem Tag="alpha" Content="Alpha"/>
                                    </ComboBox>
                                </Grid>

                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Alpha: Get the latest experimental features as soon as they're available. May contain bugs or instability."/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Beta: Get early access to upcoming features with improved stability. May still contain bugs."/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Stable: Receive only fully tested and stable releases. Recommended for everyday use."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: AI PROVIDERS -->
                <TabItem Header="AI Providers" IsVisible="{Binding ShowAiProviders}">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="14">

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource BrushTextStrong}"
                                       Text="Configure the API key and model used by each AI provider. Saved keys stay local to config.cfg."/>

                            <ItemsControl ItemsSource="{Binding Providers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AiProviderSettingsRow">
                                        <Border BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <StackPanel Spacing="10">

                                                <!-- Provider header -->
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                             Classes.configured="{Binding IsConfigured}">
                                                        <Ellipse.Styles>
                                                            <Style Selector="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushBgAccent}"/>
                                                            </Style>
                                                            <Style Selector="Ellipse.configured">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushBgSuccess}"/>
                                                            </Style>
                                                        </Ellipse.Styles>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBlock Text="configured" FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsConfigured}"
                                                               Foreground="{DynamicResource BrushTextSuccess}"/>
                                                    <TextBlock Text="not configured" FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !IsConfigured}"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                </StackPanel>

                                                <!-- API Key -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="API Key" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBox Text="{Binding ApiKey, Mode=TwoWay}"
                                                             Classes="input"
                                                             PasswordChar="●"
                                                             PlaceholderText="sk-or-v1-..."/>
                                                </StackPanel>

                                                <!-- Model -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Model" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBox Text="{Binding Model, Mode=TwoWay}"
                                                             Classes="input"
                                                             PlaceholderText="e.g. openrouter/free"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </Border>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Classes="btn"
                    MinWidth="100" Height="32"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Classes="btn-success"
                    MinWidth="100" Height="32"/>
        </StackPanel>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>
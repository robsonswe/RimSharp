<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
        xmlns:local="clr-namespace:RimSharp.AppDir.Dialogs"
        xmlns:models="clr-namespace:RimSharp.Shared.Models"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="RimSharp.AppDir.Dialogs.SettingsDialogView"
        mc:Ignorable="d"
        x:DataType="local:SettingsDialogViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        SizeToContent="Height"
        Width="680"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.MainContent>
        <Border Classes="panel">
            <TabControl Classes="tabs" Margin="12">

                <!-- TAB 1: GAME -->
                <TabItem Header="Game">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="18">

                            <!-- Distribution Selection -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Game Distribution" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextStrong}"/>

                                <ComboBox SelectedValue="{Binding SelectedDistribution, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                          Width="220"
                                          VerticalAlignment="Center"
                                          Classes="select">
                                    <ComboBoxItem Tag="{x:Static models:GameDistribution.NonSteam}" Content="Non-Steam"/>
                                    <ComboBoxItem Tag="{x:Static models:GameDistribution.Steam}"
                                                Content="Steam"
                                                ToolTip.Tip="Not auto-detected. You can still select Steam, set the Game Directory manually, and it will be validated when you Save."
                                                ToolTip.ShowOnDisabled="True"/>
                                </ComboBox>

                                <!-- Manual Steam confirmation mode: no detected candidate -->
                                <StackPanel Spacing="4" IsVisible="{Binding IsManualSteamClaim}">
                                    <TextBlock Text="{Binding ManualSteamClaimHint}"
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Check now"
                                                Command="{Binding ValidateSteamClaimCommand}"
                                                Classes="btn" Padding="10,4"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ManualSteamClaimStatus}"
                                               IsVisible="{Binding ManualSteamClaimStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Game Directory -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Game Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseGamePathCommand}"
                                            Classes="btn" Padding="10,4"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenGameFolderCommand}"
                                            Classes="btn" Padding="10,4"/>
                                </Grid>
                                <TextBox Text="{Binding GamePath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Folder where RimWorld is installed"/>
                            </StackPanel>

                            <!-- Config Directory -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Config Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseConfigPathCommand}"
                                            Classes="btn" Padding="10,4"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenConfigFolderCommand}"
                                            Classes="btn" Padding="10,4"/>
                                </Grid>
                                <TextBox Text="{Binding ConfigPath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Folder with RimWorld's config files"/>
                            </StackPanel>

                            <!-- Mods Directory Override -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Mods Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseModsFolderCommand}"
                                            Classes="btn" Padding="10,4"
                                            IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenModsFolderCommand}"
                                            Classes="btn" Padding="10,4"
                                            IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                                </Grid>
                                <TextBox Text="{Binding ModsFolderPath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Set the game path first; defaults to game\Mods"
                                         IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource BrushTextStrong}"
                                       Text="Mod and config folders resolve from these directories. Restart is not required, but already-loaded lists keep the previous paths."/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 2: UPDATES -->
                <TabItem Header="Updates">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="18">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Update Channel" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding UpdateChannel, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                              Width="140"
                                              VerticalAlignment="Center"
                                              Classes="select">
                                        <ComboBoxItem Tag="stable" Content="Stable"/>
                                        <ComboBoxItem Tag="beta" Content="Beta"/>
                                        <ComboBoxItem Tag="alpha" Content="Alpha"/>
                                    </ComboBox>
                                </Grid>

                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Alpha: Get the latest experimental features as soon as they're available. May contain bugs or instability."/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Beta: Get early access to upcoming features with improved stability. May still contain bugs."/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Stable: Receive only fully tested and stable releases. Recommended for everyday use."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: AI PROVIDERS -->
                <TabItem Header="AI Providers" IsVisible="{Binding ShowAiProviders}">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="14">

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource BrushTextStrong}"
                                       Text="Configure the API key and model used by each AI provider. Saved keys stay local to config.cfg."/>

                            <ItemsControl ItemsSource="{Binding Providers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AiProviderSettingsRow">
                                        <Border BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <StackPanel Spacing="10">

                                                <!-- Provider header -->
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                             Classes.configured="{Binding IsConfigured}">
                                                        <Ellipse.Styles>
                                                            <Style Selector="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushBgAccent}"/>
                                                            </Style>
                                                            <Style Selector="Ellipse.configured">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushBgSuccess}"/>
                                                            </Style>
                                                        </Ellipse.Styles>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBlock Text="configured" FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsConfigured}"
                                                               Foreground="{DynamicResource BrushTextSuccess}"/>
                                                    <TextBlock Text="not configured" FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !IsConfigured}"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                </StackPanel>

                                                <!-- API Key -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="API Key" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBox Text="{Binding ApiKey, Mode=TwoWay}"
                                                             Classes="input"
                                                             PasswordChar="●"
                                                             PlaceholderText="sk-or-v1-..."/>
                                                </StackPanel>

                                                <!-- Model -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Model" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBox Text="{Binding Model, Mode=TwoWay}"
                                                             Classes="input"
                                                             PlaceholderText="e.g. openrouter/free"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </TabItem>

            <!-- TAB 4: RULES -->
                <TabItem Header="Rules">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="10">

                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Text="Sources are merged in priority order — first source with a rule wins. Order rules from every source are combined. Changes apply immediately."/>

                            <ItemsControl ItemsSource="{Binding RuleSources}" x:CompileBindings="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuleSourceRowViewModel">
                                        <Border BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                                <!-- Row 1: name -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBlock Text="{Binding LockedBadge, StringFormat='({0})'}"
                                                               FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                                               IsVisible="{Binding Locked}"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                </StackPanel>
                                                <!-- Row 2: actions -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                    <Button Content="Disable" Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding Enabled}"
                                                            ToolTip.Tip="Disable this source"/>
                                                    <Button Content="Enable" Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Enabled}"
                                                            ToolTip.Tip="Enable this source"/>
                                                    <Button Content="Edit" Command="{Binding EditLocationCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Locked}"
                                                            ToolTip.Tip="Edit name and URL"/>
                                                    <Button Content="Update" Command="{Binding UpdateNowCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding CanUpdate}"
                                                            ToolTip.Tip="Refresh now"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveRuleSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Locked}"
                                                            ToolTip.Tip="Remove this source"/>
                                                </StackPanel>
                                                <!-- Row 3: subtitle -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Id}" FontSize="10"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                    <TextBlock Text="{Binding RulesAsOf, StringFormat='· as of {0}'}"
                                                               FontSize="10" Foreground="{DynamicResource BrushTextMuted}"
                                                               IsVisible="{Binding RulesAsOf, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"/>
                                                </StackPanel>
                                                <!-- Reorder -->
                                                <Button Grid.Row="0" Grid.Column="1" Content="↑"
                                                        Command="{Binding DataContext.MoveRuleSourceUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="btn" Padding="0,0" Width="20" MinWidth="0" Height="20" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move up"/>
                                                <Button Grid.Row="2" Grid.Column="1" Content="↓"
                                                        Command="{Binding DataContext.MoveRuleSourceDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="btn" Padding="0,0" Width="20" MinWidth="0" Height="20" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move down"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Add remote" Command="{Binding AddRemoteRuleSourceCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Update all" Command="{Binding UpdateAllRuleSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Reset to defaults" Command="{Binding ResetRuleSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                            </StackPanel>

                            <TextBlock Text="{Binding RuleSourcesStatus}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 5: MOD INFO -->
                <TabItem Header="Mod Info">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="10">

                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Text="Sources are checked in priority order — first source with info for a mod wins. Changes apply immediately."/>

                            <ItemsControl ItemsSource="{Binding ModInfoSources}" x:CompileBindings="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuleSourceRowViewModel">
                                        <Border BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                                <!-- Row 1: name -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBlock Text="{Binding LockedBadge, StringFormat='({0})'}"
                                                               FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                                               IsVisible="{Binding Locked}"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                </StackPanel>
                                                <!-- Row 2: actions -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                    <Button Content="Disable" Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding Enabled}"
                                                            ToolTip.Tip="Disable this source"/>
                                                    <Button Content="Enable" Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Enabled}"
                                                            ToolTip.Tip="Enable this source"/>
                                                    <Button Content="Edit" Command="{Binding EditLocationCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Locked}"
                                                            ToolTip.Tip="Edit name and URL"/>
                                                    <Button Content="Update" Command="{Binding UpdateNowCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding CanUpdate}"
                                                            ToolTip.Tip="Refresh now"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveModInfoSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Locked}"
                                                            ToolTip.Tip="Remove this source"/>
                                                </StackPanel>
                                                <!-- Row 3: subtitle -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Id}" FontSize="10"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                    <TextBlock Text="{Binding RulesAsOf, StringFormat='· as of {0}'}"
                                                               FontSize="10" Foreground="{DynamicResource BrushTextMuted}"
                                                               IsVisible="{Binding RulesAsOf, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"/>
                                                </StackPanel>
                                                <!-- Reorder -->
                                                <Button Grid.Row="0" Grid.Column="1" Content="↑"
                                                        Command="{Binding DataContext.MoveModInfoSourceUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="btn" Padding="0,0" Width="20" MinWidth="0" Height="20" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move up"/>
                                                <Button Grid.Row="2" Grid.Column="1" Content="↓"
                                                        Command="{Binding DataContext.MoveModInfoSourceDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="btn" Padding="0,0" Width="20" MinWidth="0" Height="20" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move down"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Add remote" Command="{Binding AddRemoteModInfoSourceCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Update all" Command="{Binding UpdateAllModInfoSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Reset to defaults" Command="{Binding ResetModInfoSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ModInfoSourcesStatus}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 6: REPLACEMENTS -->
                <TabItem Header="Replacements">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="10">

                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Text="Replacement suggestions (e.g. Use This Instead). Sources checked in priority order. Installed mod sources appear automatically."/>

                            <ItemsControl ItemsSource="{Binding ReplacementSources}" x:CompileBindings="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuleSourceRowViewModel">
                                        <Border BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                                <!-- Row 1: name -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBlock Text="{Binding LockedBadge, StringFormat='({0})'}"
                                                               FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                                               IsVisible="{Binding Locked}"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                </StackPanel>
                                                <!-- Row 2: actions -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                    <Button Content="Disable" Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding Enabled}"
                                                            ToolTip.Tip="Disable this source"/>
                                                    <Button Content="Enable" Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Enabled}"
                                                            ToolTip.Tip="Enable this source"/>
                                                    <Button Content="Edit" Command="{Binding EditLocationCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Locked}"
                                                            ToolTip.Tip="Edit name and URL"/>
                                                    <Button Content="Update" Command="{Binding UpdateNowCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding CanUpdate}"
                                                            ToolTip.Tip="Refresh now"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveReplacementSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Locked}"
                                                            ToolTip.Tip="Remove this source"/>
                                                </StackPanel>
                                                <!-- Row 3: subtitle -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Id}" FontSize="10"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                    <TextBlock Text="{Binding RulesAsOf, StringFormat='· as of {0}'}"
                                                               FontSize="10" Foreground="{DynamicResource BrushTextMuted}"
                                                               IsVisible="{Binding RulesAsOf, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"/>
                                                </StackPanel>
                                                <!-- Reorder -->
                                                <Button Grid.Row="0" Grid.Column="1" Content="↑"
                                                        Command="{Binding DataContext.MoveReplacementSourceUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="btn" Padding="0,0" Width="20" MinWidth="0" Height="20" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move up"/>
                                                <Button Grid.Row="2" Grid.Column="1" Content="↓"
                                                        Command="{Binding DataContext.MoveReplacementSourceDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="btn" Padding="0,0" Width="20" MinWidth="0" Height="20" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move down"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Add remote" Command="{Binding AddRemoteReplacementSourceCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Update all" Command="{Binding UpdateAllReplacementSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Reset to defaults" Command="{Binding ResetReplacementSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ReplacementSourcesStatus}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 7: NO VERSION WARNING -->
                <TabItem Header="No Version Warning">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="10">

                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       Text="Compatibility allowlists for mods running on different game versions. Sources checked in priority order. Installed mod sources appear automatically."/>

                            <ItemsControl ItemsSource="{Binding NoVersionWarningSources}" x:CompileBindings="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuleSourceRowViewModel">
                                        <Border BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                                <!-- Row 1: name -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBlock Text="{Binding LockedBadge, StringFormat='({0})'}"
                                                               FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                                               IsVisible="{Binding Locked}"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                </StackPanel>
                                                <!-- Row 2: actions -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                    <Button Content="Disable" Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding Enabled}"
                                                            ToolTip.Tip="Disable this source"/>
                                                    <Button Content="Enable" Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Enabled}"
                                                            ToolTip.Tip="Enable this source"/>
                                                    <Button Content="Edit" Command="{Binding EditLocationCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Locked}"
                                                            ToolTip.Tip="Edit name and URL"/>
                                                    <Button Content="Update" Command="{Binding UpdateNowCommand}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding CanUpdate}"
                                                            ToolTip.Tip="Refresh now"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveNoVersionWarningSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn" Padding="6,2" MinWidth="0" MinHeight="0"
                                                            IsVisible="{Binding !Locked}"
                                                            ToolTip.Tip="Remove this source"/>
                                                </StackPanel>
                                                <!-- Row 3: subtitle -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Id}" FontSize="10"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                    <TextBlock Text="{Binding RulesAsOf, StringFormat='· as of {0}'}"
                                                               FontSize="10" Foreground="{DynamicResource BrushTextMuted}"
                                                               IsVisible="{Binding RulesAsOf, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"/>
                                                </StackPanel>
                                                <!-- Reorder -->
                                                <Button Grid.Row="0" Grid.Column="1" Content="↑"
                                                        Command="{Binding DataContext.MoveNoVersionWarningSourceUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="btn" Padding="0,0" Width="20" MinWidth="0" Height="20" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move up"/>
                                                <Button Grid.Row="2" Grid.Column="1" Content="↓"
                                                        Command="{Binding DataContext.MoveNoVersionWarningSourceDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Classes="btn" Padding="0,0" Width="20" MinWidth="0" Height="20" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Move down"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Add remote" Command="{Binding AddRemoteNoVersionWarningSourceCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Update all" Command="{Binding UpdateAllNoVersionWarningSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Reset to defaults" Command="{Binding ResetNoVersionWarningSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                            </StackPanel>

                            <TextBlock Text="{Binding NoVersionWarningSourcesStatus}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </Border>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Classes="btn"
                    MinWidth="100" Height="32"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Classes="btn-success"
                    MinWidth="100" Height="32"/>
        </StackPanel>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>
<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
        xmlns:local="clr-namespace:RimSharp.AppDir.Dialogs"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="RimSharp.AppDir.Dialogs.SettingsDialogView"
        mc:Ignorable="d"
        x:DataType="local:SettingsDialogViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        SizeToContent="Height"
        Width="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.MainContent>
        <Border Classes="RimworldPanelBorder">
            <TabControl Classes="RimworldTabControl" Margin="12">

                <!-- TAB 1: PATHS -->
                <TabItem Header="Paths">
                    <Border Classes="RimworldSubtlePanelBorder">
                        <StackPanel Margin="15" Spacing="18">

                            <!-- Game Directory -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Game Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource RimworldDarkBrownBrush}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseGamePathCommand}"
                                            Classes="RimworldButtonStyle" Padding="10,4"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenGameFolderCommand}"
                                            Classes="RimworldButtonStyle" Padding="10,4"/>
                                </Grid>
                                <TextBox Text="{Binding GamePath, Mode=TwoWay}"
                                         Classes="RimworldTextBox"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         Watermark="Folder where RimWorld is installed"/>
                            </StackPanel>

                            <!-- Config Directory -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Config Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource RimworldDarkBrownBrush}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseConfigPathCommand}"
                                            Classes="RimworldButtonStyle" Padding="10,4"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenConfigFolderCommand}"
                                            Classes="RimworldButtonStyle" Padding="10,4"/>
                                </Grid>
                                <TextBox Text="{Binding ConfigPath, Mode=TwoWay}"
                                         Classes="RimworldTextBox"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         Watermark="Folder with RimWorld's config files"/>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource RimworldDarkBrownBrush}"
                                       Text="Mod and config folders resolve from these directories. Restart is not required, but already-loaded lists keep the previous paths."/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 2: AI PROVIDERS -->
                <TabItem Header="AI Providers">
                    <Border Classes="RimworldSubtlePanelBorder">
                        <StackPanel Margin="15" Spacing="14">

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource RimworldDarkBrownBrush}"
                                       Text="Configure the API key and model used by each AI provider. Saved keys stay local to config.cfg."/>

                            <ItemsControl ItemsSource="{Binding Providers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AiProviderSettingsRow">
                                        <Border BorderBrush="{DynamicResource RimworldBrownBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <StackPanel Spacing="10">

                                                <!-- Provider header -->
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                             Classes.configured="{Binding IsConfigured}">
                                                        <Ellipse.Styles>
                                                            <Style Selector="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource RimworldLightBrownBrush}"/>
                                                            </Style>
                                                            <Style Selector="Ellipse.configured">
                                                                <Setter Property="Fill" Value="{DynamicResource RimworldDarkGreenBrush}"/>
                                                            </Style>
                                                        </Ellipse.Styles>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource RimworldDarkBrownBrush}"/>
                                                    <TextBlock Text="configured" FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsConfigured}"
                                                               Foreground="{DynamicResource RimworldDarkGreenBrush}"/>
                                                    <TextBlock Text="not configured" FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !IsConfigured}"
                                                               Foreground="{DynamicResource RimworldDarkBrownBrush}"/>
                                                </StackPanel>

                                                <!-- API Key -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="API Key" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource RimworldDarkBrownBrush}"/>
                                                    <TextBox Text="{Binding ApiKey, Mode=TwoWay}"
                                                             Classes="RimworldTextBox"
                                                             PasswordChar="●"
                                                             Watermark="sk-or-v1-..."/>
                                                </StackPanel>

                                                <!-- Model -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Model" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource RimworldDarkBrownBrush}"/>
                                                    <TextBox Text="{Binding Model, Mode=TwoWay}"
                                                             Classes="RimworldTextBox"
                                                             Watermark="e.g. openrouter/free"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </Border>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Classes="RimworldButtonStyle"
                    MinWidth="100" Height="32"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Classes="RimworldSaveButtonStyle"
                    MinWidth="100" Height="32"/>
        </StackPanel>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>

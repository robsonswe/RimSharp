<dialogs:BaseDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:RimSharp.Infrastructure.Dialog"
        xmlns:local="clr-namespace:RimSharp.AppDir.Dialogs"
        xmlns:models="clr-namespace:RimSharp.Shared.Models"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="RimSharp.AppDir.Dialogs.SettingsDialogView"
        mc:Ignorable="d"
        x:DataType="local:SettingsDialogViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        SizeToContent="Height"
        Width="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <dialogs:BaseDialog.MainContent>
        <Border Classes="panel">
            <TabControl Classes="tabs" Margin="12">

                <!-- TAB 1: GAME -->
                <TabItem Header="Game">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="18">

                            <!-- Distribution Selection -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Game Distribution" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextStrong}"/>

                                <ComboBox SelectedValue="{Binding SelectedDistribution, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                          Width="220"
                                          VerticalAlignment="Center"
                                          Classes="select">
                                    <ComboBoxItem Tag="{x:Static models:GameDistribution.NonSteam}" Content="Non-Steam"/>
                                    <ComboBoxItem Tag="{x:Static models:GameDistribution.Steam}"
                                                Content="Steam"
                                                ToolTip.Tip="Not auto-detected. You can still select Steam, set the Game Directory manually, and it will be validated when you Save."
                                                ToolTip.ShowOnDisabled="True"/>
                                </ComboBox>

                                <!-- Manual Steam confirmation mode: no detected candidate -->
                                <StackPanel Spacing="4" IsVisible="{Binding IsManualSteamClaim}">
                                    <TextBlock Text="{Binding ManualSteamClaimHint}"
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Check now"
                                                Command="{Binding ValidateSteamClaimCommand}"
                                                Classes="btn" Padding="10,4"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ManualSteamClaimStatus}"
                                               IsVisible="{Binding ManualSteamClaimStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Game Directory -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Game Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseGamePathCommand}"
                                            Classes="btn" Padding="10,4"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenGameFolderCommand}"
                                            Classes="btn" Padding="10,4"/>
                                </Grid>
                                <TextBox Text="{Binding GamePath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Folder where RimWorld is installed"/>
                            </StackPanel>

                            <!-- Config Directory -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Config Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseConfigPathCommand}"
                                            Classes="btn" Padding="10,4"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenConfigFolderCommand}"
                                            Classes="btn" Padding="10,4"/>
                                </Grid>
                                <TextBox Text="{Binding ConfigPath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Folder with RimWorld's config files"/>
                            </StackPanel>

                            <!-- Mods Directory Override -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Mods Directory" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding BrowseModsFolderCommand}"
                                            Classes="btn" Padding="10,4"
                                            IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                                    <Button Grid.Column="2" Content="Open Folder"
                                            Command="{Binding OpenModsFolderCommand}"
                                            Classes="btn" Padding="10,4"
                                            IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                                </Grid>
                                <TextBox Text="{Binding ModsFolderPath, Mode=TwoWay}"
                                         Classes="input"
                                         TextWrapping="Wrap"
                                         MinHeight="30"
                                         PlaceholderText="Set the game path first; defaults to game\Mods"
                                         IsEnabled="{Binding IsGamePathSet, Mode=OneWay}"/>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource BrushTextStrong}"
                                       Text="Mod and config folders resolve from these directories. Restart is not required, but already-loaded lists keep the previous paths."/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 2: UPDATES -->
                <TabItem Header="Updates">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="18">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="Update Channel" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding UpdateChannel, Mode=TwoWay}"
                                              SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}"
                                              Width="140"
                                              VerticalAlignment="Center"
                                              Classes="select">
                                        <ComboBoxItem Tag="stable" Content="Stable"/>
                                        <ComboBoxItem Tag="beta" Content="Beta"/>
                                        <ComboBoxItem Tag="alpha" Content="Alpha"/>
                                    </ComboBox>
                                </Grid>

                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Alpha: Get the latest experimental features as soon as they're available. May contain bugs or instability."/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Beta: Get early access to upcoming features with improved stability. May still contain bugs."/>
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource BrushTextStrong}"
                                           Text="Stable: Receive only fully tested and stable releases. Recommended for everyday use."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: AI PROVIDERS -->
                <TabItem Header="AI Providers" IsVisible="{Binding ShowAiProviders}">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="14">

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource BrushTextStrong}"
                                       Text="Configure the API key and model used by each AI provider. Saved keys stay local to config.cfg."/>

                            <ItemsControl ItemsSource="{Binding Providers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AiProviderSettingsRow">
                                        <Border BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <StackPanel Spacing="10">

                                                <!-- Provider header -->
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                             Classes.configured="{Binding IsConfigured}">
                                                        <Ellipse.Styles>
                                                            <Style Selector="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushBgAccent}"/>
                                                            </Style>
                                                            <Style Selector="Ellipse.configured">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushBgSuccess}"/>
                                                            </Style>
                                                        </Ellipse.Styles>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBlock Text="configured" FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsConfigured}"
                                                               Foreground="{DynamicResource BrushTextSuccess}"/>
                                                    <TextBlock Text="not configured" FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !IsConfigured}"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                </StackPanel>

                                                <!-- API Key -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="API Key" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBox Text="{Binding ApiKey, Mode=TwoWay}"
                                                             Classes="input"
                                                             PasswordChar="●"
                                                             PlaceholderText="sk-or-v1-..."/>
                                                </StackPanel>

                                                <!-- Model -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Model" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextStrong}"/>
                                                    <TextBox Text="{Binding Model, Mode=TwoWay}"
                                                             Classes="input"
                                                             PlaceholderText="e.g. openrouter/free"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </TabItem>

            <!-- TAB 4: RULE DATABASES -->
                <TabItem Header="Rule Databases">
                    <Border Classes="panel-subtle">
                        <StackPanel Margin="15" Spacing="12">

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource BrushTextStrong}"
                                       Text="Rule databases are merged in priority order: the first source that carries a rule for a mod wins, and order rules from every source are combined. Changes apply immediately - no restart needed."/>

                            <ItemsControl ItemsSource="{Binding RuleSources}"
                                          x:CompileBindings="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RuleSourceRowViewModel">
                                        <Border BorderBrush="{DynamicResource BrushBorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="8">
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Content="Disable"
                                                            Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2"
                                                            IsVisible="{Binding Enabled}"
                                                            ToolTip.Tip="Disable this source"/>
                                                    <Button Content="Enable"
                                                            Command="{Binding ToggleEnabledCommand}"
                                                            Classes="btn" Padding="6,2"
                                                            IsVisible="{Binding !Enabled}"
                                                            ToolTip.Tip="Enable this source"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontWeight="Bold" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource BrushTextStrong}"/>

                                                <!-- URL is edited via the Edit dialog; nothing inline here. -->

                                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="{Binding Id}"
                                                           FontSize="10"
                                                           Margin="30,2,0,0"
                                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                           Text="{Binding RulesAsOf, StringFormat='Rules as of {0}'}"
                                                           FontSize="10"
                                                           Margin="30,0,0,0"
                                                           IsVisible="{Binding RulesAsOf, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                                                           Foreground="{DynamicResource BrushTextMuted}"/>

                                                <!-- Per-source list actions: Remove / Move up / Move down -->
                                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                            Orientation="Horizontal" Spacing="6"
                                                            Margin="30,6,0,0">
                                                    <Button Content="Edit"
                                                            Command="{Binding EditLocationCommand}"
                                                            Classes="btn" Padding="8,4"
                                                            IsEnabled="{Binding !Locked}"
                                                            ToolTip.Tip="Edit this source's name and URL"/>
                                                    <Button Content="Update"
                                                            Command="{Binding UpdateNowCommand}"
                                                            Classes="btn" Padding="8,4"
                                                            ToolTip.Tip="Refresh this source now"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveRuleSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn" Padding="8,4"
                                                            IsEnabled="{Binding !Locked}"
                                                            ToolTip.Tip="Remove this rule source"/>
                                                    <Button Content="Move up"
                                                            Command="{Binding DataContext.MoveRuleSourceUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn" Padding="8,4"
                                                            ToolTip.Tip="Move this source up in priority"/>
                                                    <Button Content="Move down"
                                                            Command="{Binding DataContext.MoveRuleSourceDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn" Padding="8,4"
                                                            ToolTip.Tip="Move this source down in priority"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Add remote" Command="{Binding AddRemoteRuleSourceCommand}"
                                        Classes="btn" Padding="10,4"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Update all" Command="{Binding UpdateAllRuleSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                                <Button Content="Reset to defaults" Command="{Binding ResetRuleSourcesCommand}"
                                        Classes="btn" Padding="10,4"/>
                            </StackPanel>

                            <TextBlock Text="{Binding RuleSourcesStatus}"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </Border>
    </dialogs:BaseDialog.MainContent>

    <dialogs:BaseDialog.ButtonContent>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Classes="btn"
                    MinWidth="100" Height="32"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Classes="btn-success"
                    MinWidth="100" Height="32"/>
        </StackPanel>
    </dialogs:BaseDialog.ButtonContent>
</dialogs:BaseDialog>
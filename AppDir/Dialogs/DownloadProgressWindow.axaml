<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RimSharp.AppDir.Dialogs"
        xmlns:vm="clr-namespace:RimSharp.AppDir.Dialogs"
        mc:Ignorable="d"
        x:Class="RimSharp.AppDir.Dialogs.DownloadProgressWindow"
        x:DataType="vm:DownloadProgressWindowViewModel"
        Title="Download Progress" Height="550" Width="800"
        MinHeight="400" MinWidth="600"
        Background="{DynamicResource RimworldBeigeBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Download / Post-Processing Progress"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource RimworldBrownBrush}" Margin="0,0,0,10"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  GridLinesVisibility="All" RowHeight="36" CanUserResizeColumns="True"
                  CanUserReorderColumns="True" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Steam ID" Width="120" Binding="{Binding SteamId}"/>
                <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Status" Width="140" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Progress" Width="100" Binding="{Binding ProgressString}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="Close" Command="{Binding CloseCommand}"
                HorizontalAlignment="Right" Margin="0,10,0,0" Classes="RimworldRunButtonStyle"/>
    </Grid>
</Window>
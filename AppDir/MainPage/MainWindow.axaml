<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RimSharp.AppDir.MainPage"
        xmlns:vm="clr-namespace:RimSharp.AppDir.MainPage"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        mc:Ignorable="d"
        x:Class="RimSharp.AppDir.MainPage.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RimSharp - RimWorld Mod Manager" Height="900" Width="1200"
        MinHeight="700" MinWidth="1200"
        Background="{DynamicResource BrushBgSurface}">

    <Window.Styles>
        <Style Selector="Ellipse.StatusBall">
            <Setter Property="Fill" Value="{DynamicResource BrushBgSuccess}"/>
        </Style>
        <Style Selector="Ellipse.StatusBall.update-available">
            <Setter Property="Fill" Value="{DynamicResource BrushBgDanger}"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Fill" Value="{DynamicResource BrushBgDanger}"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Fill" Value="{DynamicResource BrushBgDangerLight}"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Fill" Value="{DynamicResource BrushBgDanger}"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel IsVisible="{Binding !IsInitialLoading}">
            <!-- Compact Header Bar (Merged Settings and Tabs) -->
            <Border DockPanel.Dock="Top" Margin="8,8,8,0" Classes="panel" Background="{DynamicResource BrushBgPanel}" Padding="12,4">
                <Grid ColumnDefinitions="*,Auto">

                    <!-- Left Side: App Title + Tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RimSharp" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                            <Button Content="Mods"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="Mods"
                                    Classes="btn-tab"
                                    Classes.active="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Mods}"/>
                            <Button Content="Downloader"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="Downloader"
                                    Classes="btn-tab"
                                    Classes.active="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Downloader}"/>
                            <Button Content="Git Mods"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="GitMods"
                                    Classes="btn-tab"
                                    Classes.active="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=GitMods}"/>
                            <Button Content="VRAM Analysis"
                                    Command="{Binding SwitchTabCommand}" CommandParameter="VRAM"
                                    Classes="btn-tab"
                                    Classes.active="{Binding SelectedTab, Converter={StaticResource EqualityConverter}, ConverterParameter=VRAM}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Side: Info + Global Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <!-- Game Version Badge -->
                        <Border Background="{DynamicResource BrushBgAccent}"
                                BorderBrush="{DynamicResource BrushBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="12,4"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding UpdateTooltipText}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Classes="StatusBall"
                                         Classes.update-available="{Binding IsUpdateAvailable}">
                                </Ellipse>

                                <TextBlock Text="{Binding PathSettings.GameVersion, StringFormat='RW v\{0\}'}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Refresh Action -->
                        <Button Command="{Binding RefreshCommand}"
                                Classes="btn"
                                Padding="12,4"
                                MinWidth="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <i:Icon Value="fa-rotate-right" VerticalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Menu Dropdown -->
                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Classes="menu-dropdown">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Menu" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Header="Settings" Command="{Binding SettingsCommand}" Classes="menu-item">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-gear" VerticalAlignment="Center" FontSize="14"/>
                                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Header="About" Command="{Binding AboutCommand}" Classes="menu-item">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <i:Icon Value="fa-info" VerticalAlignment="Center" FontSize="14"/>
                                            <TextBlock Text="About" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </MenuItem>
                        </Menu>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Border Margin="8" Classes="panel" Background="{DynamicResource BrushBgSurface}">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </DockPanel>

        <!-- Initial Loading Overlay -->
        <Grid IsVisible="{Binding IsInitialLoading}">
            <!-- Dimmed Background -->
            <Border Background="#99000000"/>

            <!-- Loading Card -->
            <Border Classes="panel"
                    Width="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="30"
                    BorderThickness="2"
                    CornerRadius="5">
                <StackPanel Spacing="15">
                    <!-- App Icon -->
                    <Image Source="avares://RimSharp/icon.ico" Width="64" Height="64" Margin="0,0,0,15"/>

                    <!-- Title -->
                    <TextBlock Text="RimSharp"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               HorizontalAlignment="Center"/>

                    <!-- Subtitle -->
                    <TextBlock Text="RimWorld Mod Manager"
                               FontSize="16"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"/>

                    <!-- App Version -->
                    <TextBlock Text="{Binding AppVersion, FallbackValue='v1.0.0', TargetNullValue='v1.0.0'}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"/>

                    <!-- Custom Progress Bar -->
                    <ProgressBar Value="{Binding InitialLoadingProgress, FallbackValue=0}"
                                 IsIndeterminate="False"
                                 Classes="progress"
                                 Height="10" />

                    <!-- Status Text -->
                    <TextBlock Text="{Binding ModsVM.LoadingMessage}"
                               FontSize="14"
                               Foreground="{DynamicResource BrushTextStrong}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="380"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
